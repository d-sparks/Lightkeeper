  "triggers": [
    {
      "id": "darkness_warning_no_sol",
      "event": "room_entered",
      "conditions": [
        {
          "not": {
            "hasFlag": "received_sol_unit"
          }
        }
      ],
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "You step beyond the outpost walls. The darkness here is absolute — the void presses in from all sides.",
            "You can feel it pulling at you already. Without a Sol Unit, you won't last long out here.",
            "Turn back. Find the engineer in the Outpost Workshop and get a Sol Unit before venturing into the dark."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "darkness_warning_has_sol",
      "event": "room_entered",
      "conditions": [
        {
          "hasFlag": "received_sol_unit"
        }
      ],
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "You step beyond the outpost walls. The darkness here is absolute — the void presses in from all sides.",
            "Your Sol Unit hums faintly against the pressing dark. Stay sharp."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "first_combat_survival_tips",
      "event": "monster_killed",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "Keep moving in combat — enemies will close in fast. Strafe and kite to stay alive.",
            "Press [Q] to heal with your Medipac when health drops. Watch your energy bar — sol abilities drain it quickly, but your blaster is free."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "lore_field_report_pickup",
      "event": "item_picked_up",
      "filter": {
        "itemType": "lore_field_report"
      },
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "A crumpled survey report stamped UNVERIFIED:",
            "'Survey Team 4, Day 11. Found structures at coordinates [redacted]. Not human construction — geometry is wrong. Walls curve inward at angles that don't match any known engineering.'",
            "'Material is warm to the touch despite ambient temp of -40C. Faint glow from deep inside, no identifiable source.'",
            "The report was never followed up on."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "power_cell_pickup",
      "event": "item_picked_up",
      "filter": {
        "itemType": "backup_power_cell"
      },
      "actions": [
        {
          "type": "showMessage",
          "text": "A backup power cell in good condition. Comms Officer Daley needs one of these to repair the long-range radio."
        }
      ],
      "once": true
    }
  ]
