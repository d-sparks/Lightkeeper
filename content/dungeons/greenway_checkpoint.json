  "triggers": [
    {
      "id": "arrive_checkpoint",
      "event": "room_entered",
      "conditions": [{ "not": { "hasFlag": "visited_greenway_checkpoint" } }],
      "actions": [
        { "type": "showMessage", "lines": [
          "The corridor opens into a wide agricultural transit hub. Bright grow-lights line the ceiling, casting everything in warm amber.",
          "But the warmth ends at the barricades. Bulwark soldiers in grey uniforms man a checkpoint across the main path. Military drones hover overhead, scanning.",
          "Beyond the barricade, you can see the Greenway \u2014 rows of crops stretching into the distance, greenhouses glinting under artificial sun. And far beyond, a tall stone structure rises above the fields: the Monument of Winds."
        ]},
        { "type": "setFlag", "flag": "visited_greenway_checkpoint" }
      ],
      "once": true
    },
    {
      "id": "checkpoint_pass_granted",
      "event": "npc_interacted",
      "filter": { "npcType": "checkpoint_officer_maren" },
      "conditions": [
        { "hasItem": "greenway_pass" },
        { "not": { "hasFlag": "greenway_pass_granted" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "greenway_pass_granted" },
        { "type": "removeItem", "itemType": "greenway_pass" },
        { "type": "showMessage", "lines": [
          "Officer Maren examines your transit pass, then nods curtly.",
          "'Authorization confirmed. You may proceed through the checkpoint. Stay on designated paths.'"
        ]},
        { "type": "grantXp", "amount": 20 }
      ],
      "once": true
    },
    {
      "id": "supply_crate_loot",
      "event": "door_interacted",
      "filter": { "tileX": 3, "tileY": 11 },
      "actions": [
        { "type": "spawnItem", "itemType": "military_medkit", "x": 4, "y": 11 },
        { "type": "showMessage", "text": "The supply crate contains military medical supplies." }
      ],
      "once": true
    },
    {
      "id": "notice_board_checkpoint",
      "event": "door_interacted",
      "filter": { "tileX": 13, "tileY": 7 },
      "actions": [
        { "type": "showMessage", "lines": [
          "\u2014 COMPACT EMERGENCY ORDER 7-C \u2014",
          "By authority of General Thorne, all civilian transit through the Greenway agricultural corridor requires Compact authorization.",
          "The Monument of Winds and surrounding area are designated RESTRICTED MILITARY ZONES.",
          "Unauthorized personnel will be detained. This order is effective immediately and supersedes all prior civic agreements."
        ]}
      ]
    }
  ]
