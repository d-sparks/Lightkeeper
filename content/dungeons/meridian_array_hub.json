    {
      "id": "array_hub_trade",
      "event": "npc_interacted",
      "filter": { "npcType": "meridian_7_hub" },
      "conditions": [
        { "not": { "hasFlag": "array_hub_traded" } }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "array_hub_trade", "prompt": "MERIDIAN-7 Hub Terminal. Available services:", "options": [
          { "label": "Sol Shield Emitter", "description": "Defensive ability component. Creates energy barrier. Costs significant resources.", "value": "shield" },
          { "label": "Charge Sol Unit", "description": "Fully recharge your Sol Unit's energy.", "value": "charge" },
          { "label": "Browse Only", "description": "Just looking.", "value": "browse" }
        ]}
      ]
    },
    {
      "id": "array_buy_shield",
      "event": "choice_made",
      "filter": { "choiceId": "array_hub_trade", "value": "shield" },
      "actions": [
        { "type": "giveItem", "itemType": "sol_shield_chip" },
        { "type": "setFlag", "flag": "array_hub_traded" },
        { "type": "grantXp", "amount": 20 },
        { "type": "showMessage", "lines": [
          "The terminal hums. A compartment slides open revealing the Sol Shield Emitter.",
          "MERIDIAN-7 speaks: 'Sol Shield Emitter — defensive capability. Place in your Sol Grid. Activation creates a brief energy barrier that absorbs incoming damage.'",
          "'We recommend placing it adjacent to a Power Tap for optimal performance. Enjoy your purchase.'"
        ]}
      ]
    },
    {
      "id": "array_charge",
      "event": "choice_made",
      "filter": { "choiceId": "array_hub_trade", "value": "charge" },
      "actions": [
        { "type": "setEnergy", "percent": 100 },
        { "type": "showMessage", "text": "The terminal emits a warm pulse. Your Sol Unit's energy cells fill to capacity. 'Charging complete. The Array powers progress.'" }
      ]
    },
    {
      "id": "array_premium_notice",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "accepted_array_deal" }
      ],
      "actions": [
        { "type": "showMessage", "text": "A soft chime. 'Premium access detected. Enhanced services available. Welcome back.'" }
      ],
      "once": true
    },
    {
      "id": "array_premium_bonus",
      "event": "npc_interacted",
      "filter": { "npcType": "meridian_7_hub" },
      "conditions": [
        { "hasFlag": "accepted_array_deal" },
        { "not": { "hasFlag": "array_premium_bonus_given" } }
      ],
      "actions": [
        { "type": "giveItem", "itemType": "health_potion", "count": 3 },
        { "type": "giveItem", "itemType": "field_medkit" },
        { "type": "setFlag", "flag": "array_premium_bonus_given" },
        { "type": "showMessage", "lines": [
          "MERIDIAN-7: 'As a premium partner, please accept this complimentary supply package.'",
          "'Your exploration data has been most valuable. I look forward to learning more about your... experiences in the field.'"
        ]}
      ],
      "once": true
    }
