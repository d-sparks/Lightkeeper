  "triggers": [
    {
      "id": "enter_array_hub",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "The MERIDIAN-7 Hub. It's conspicuously cleaner than anything else in the city — polished surfaces, soft ambient lighting, climate-controlled air.",
          "A large holographic display cycles through advertisements: energy solutions, trade opportunities, 'partnership programs.' The Array's aesthetic is unmistakable."
