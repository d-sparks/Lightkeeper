  "triggers": [
    {
      "id": "enter_market",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "The Market Quarter. Stalls and shops line the wide avenue, their displays bright with goods you haven't seen since before the frontier.",
          "The smell of cooked food, the hum of conversation, the clink of trade — after weeks in the dark, it's intoxicating."
        ]}
      ],
      "once": true
    },
    {
      "id": "reva_shop",
      "event": "npc_interacted",
      "filter": { "npcType": "merchant_reva" },
      "conditions": [
        { "not": { "hasFlag": "bought_from_reva" } }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "reva_shop", "prompt": "Merchant Reva's General Goods. What would you like to buy?", "options": [
          { "label": "Health Potions (x3)", "description": "Three health potions. Always useful.", "value": "potions" },
          { "label": "Copper Coils (x2)", "description": "Crafting material for battery construction.", "value": "coils" },
          { "label": "Field Medkit", "description": "Advanced medical supplies. Restores 40 HP.", "value": "medkit" },
          { "label": "Nothing", "description": "Just browsing.", "value": "nothing" }
        ]}
      ]
    },
    {
      "id": "reva_buy_potions",
      "event": "choice_made",
      "filter": { "choiceId": "reva_shop", "value": "potions" },
      "actions": [
        { "type": "giveItem", "itemType": "health_potion", "count": 3 },
        { "type": "setFlag", "flag": "bought_from_reva" },
        { "type": "setFlag", "flag": "reva_mentioned_solen" },
        { "type": "showMessage", "text": "Reva wraps three potions in cloth. 'Good choice. You can never have too many of these.'" }
      ]
    },
    {
      "id": "reva_buy_coils",
      "event": "choice_made",
      "filter": { "choiceId": "reva_shop", "value": "coils" },
      "actions": [
        { "type": "giveItem", "itemType": "copper_coil", "count": 2 },
        { "type": "setFlag", "flag": "bought_from_reva" },
        { "type": "setFlag", "flag": "reva_mentioned_solen" },
        { "type": "showMessage", "text": "Reva produces two neatly wound copper coils. 'For the workshop, eh? Yun's a good craftsman. Tell him Reva says hello.'" }
      ]
    },
    {
      "id": "reva_buy_medkit",
      "event": "choice_made",
      "filter": { "choiceId": "reva_shop", "value": "medkit" },
      "actions": [
        { "type": "giveItem", "itemType": "field_medkit" },
        { "type": "setFlag", "flag": "bought_from_reva" },
        { "type": "setFlag", "flag": "reva_mentioned_solen" },
        { "type": "showMessage", "text": "Reva hands over a properly stocked medkit. 'Military-grade. Don't ask where I got it.'" }
      ]
    },
    {
      "id": "garro_shop",
      "event": "npc_interacted",
      "filter": { "npcType": "weaponsmith_garro" },
      "conditions": [
        { "not": { "hasFlag": "bought_from_garro" } }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "garro_shop", "prompt": "Weaponsmith Garro's Forge. Select a weapon to purchase.", "options": [
          { "label": "Tempered Blade", "description": "8 ATK melee weapon. Solid city-forged steel.", "value": "blade" },
          { "label": "Precision Blaster", "description": "6 ATK ranged weapon. Fast and accurate.", "value": "blaster" },
          { "label": "Shock Baton", "description": "7 ATK melee weapon. Enhanced knockback.", "value": "baton" },
          { "label": "Pulse Rifle", "description": "5 ATK ranged weapon. Concentrated energy pulses.", "value": "rifle" }
        ]}
      ]
    },
    {
      "id": "garro_buy_blade",
      "event": "choice_made",
      "filter": { "choiceId": "garro_shop", "value": "blade" },
      "actions": [
        { "type": "giveItem", "itemType": "tempered_blade" },
        { "type": "setFlag", "flag": "bought_from_garro" },
        { "type": "grantXp", "amount": 10 },
        { "type": "showMessage", "text": "Garro presents a gleaming blade. 'Tempered three times. The edge will hold through bone and chitin alike.'" }
      ]
    },
    {
      "id": "garro_buy_blaster",
      "event": "choice_made",
      "filter": { "choiceId": "garro_shop", "value": "blaster" },
      "actions": [
        { "type": "giveItem", "itemType": "precision_blaster" },
        { "type": "setFlag", "flag": "bought_from_garro" },
        { "type": "grantXp", "amount": 10 },
        { "type": "showMessage", "text": "Garro passes over a sleek blaster. 'Precision optics. Faster cycle rate than standard issue. You'll feel the difference immediately.'" }
      ]
    },
    {
      "id": "garro_buy_baton",
      "event": "choice_made",
      "filter": { "choiceId": "garro_shop", "value": "baton" },
      "actions": [
        { "type": "giveItem", "itemType": "shock_baton" },
        { "type": "setFlag", "flag": "bought_from_garro" },
        { "type": "grantXp", "amount": 10 },
        { "type": "showMessage", "text": "Garro hefts the baton, then hands it over. 'Capacitor-charged. One swing and they'll wish they'd stayed down.'" }
      ]
    },
    {
      "id": "garro_buy_rifle",
      "event": "choice_made",
      "filter": { "choiceId": "garro_shop", "value": "rifle" },
      "actions": [
        { "type": "giveItem", "itemType": "pulse_rifle" },
        { "type": "setFlag", "flag": "bought_from_garro" },
        { "type": "grantXp", "amount": 15 },
        { "type": "showMessage", "text": "Garro unwraps the rifle from its protective case. 'Military surplus. Refurbished with my own modifications. Treat it well — I won't find another one.'" }
      ]
    },
    {
      "id": "mira_shop",
      "event": "npc_interacted",
      "filter": { "npcType": "component_dealer_mira" },
      "conditions": [
        { "not": { "hasFlag": "bought_from_mira" } }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "mira_shop", "prompt": "Component Dealer Mira's stock. Select a Sol Grid component.", "options": [
          { "label": "Efficiency Core", "description": "Modifier: -20% cooldown for adjacent abilities.", "value": "efficiency" },
          { "label": "Area Expander", "description": "Modifier: +20% damage for adjacent abilities.", "value": "expander" },
          { "label": "Power Tap", "description": "Rare modifier: +15% damage and cooldown reduction.", "value": "powertap" }
        ]}
      ]
    },
    {
      "id": "mira_buy_efficiency",
      "event": "choice_made",
      "filter": { "choiceId": "mira_shop", "value": "efficiency" },
      "actions": [
        { "type": "giveItem", "itemType": "efficiency_core_chip" },
        { "type": "setFlag", "flag": "bought_from_mira" },
        { "type": "grantXp", "amount": 10 },
        { "type": "showMessage", "text": "Mira carefully packages the Efficiency Core. 'Place it next to your main ability. You'll notice the difference immediately — smoother cycling, less energy drain.'" }
      ]
    },
    {
      "id": "mira_buy_expander",
      "event": "choice_made",
      "filter": { "choiceId": "mira_shop", "value": "expander" },
      "actions": [
        { "type": "giveItem", "itemType": "area_expander_chip" },
        { "type": "setFlag", "flag": "bought_from_mira" },
        { "type": "grantXp", "amount": 10 },
        { "type": "showMessage", "text": "Mira wraps the Area Expander in anti-static cloth. 'This one amplifies the output of whatever it's next to. More power per pulse.'" }
      ]
    },
    {
      "id": "mira_buy_powertap",
      "event": "choice_made",
      "filter": { "choiceId": "mira_shop", "value": "powertap" },
      "actions": [
        { "type": "giveItem", "itemType": "power_tap_chip" },
        { "type": "setFlag", "flag": "bought_from_mira" },
        { "type": "grantXp", "amount": 20 },
        { "type": "showMessage", "lines": [
          "Mira handles the Power Tap with reverence. 'This is the real deal. Genuine power generation module. Place it smart — it boosts everything around it.'",
          "She leans in. 'You want the best components? They're not in shops. They're in the old perimeter stations, buried in the dark. Deep salvage. Keep that in mind.'"
        ]}
      ]
    },

    {
      "id": "reva_return_shop",
      "event": "npc_interacted",
      "filter": { "npcType": "merchant_reva" },
      "conditions": [
        { "hasFlag": "bought_from_reva" }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "reva_return", "prompt": "Reva's General Goods — return customer special. What can I get you?", "options": [
          { "label": "Collector Kits (x2)", "description": "Solar collector kits for your salvage yard build pads.", "value": "seeds" },
          { "label": "Copper Coils (x2)", "description": "Crafting material for battery construction.", "value": "coils" },
          { "label": "Health Potions (x3)", "description": "Three health potions.", "value": "potions" },
          { "label": "Nothing", "description": "Just browsing.", "value": "nothing" }
        ]}
      ]
    },
    {
      "id": "reva_return_buy_seeds",
      "event": "choice_made",
      "filter": { "choiceId": "reva_return", "value": "seeds" },
      "actions": [
        { "type": "giveItem", "itemType": "collector_kit", "count": 2 },
        { "type": "showMessage", "text": "Reva hands over two collector kits. 'From my best supplier. Standard photovoltaic, rated for the East Terrace light levels.'" }
      ]
    },
    {
      "id": "reva_return_buy_coils",
      "event": "choice_made",
      "filter": { "choiceId": "reva_return", "value": "coils" },
      "actions": [
        { "type": "giveItem", "itemType": "copper_coil", "count": 2 },
        { "type": "showMessage", "text": "Reva produces two copper coils. 'Same quality as always. Yun's standards are my standards.'" }
      ]
    },
    {
      "id": "reva_return_buy_potions",
      "event": "choice_made",
      "filter": { "choiceId": "reva_return", "value": "potions" },
      "actions": [
        { "type": "giveItem", "itemType": "health_potion", "count": 3 },
        { "type": "showMessage", "text": "Reva wraps three potions in cloth. 'A classic. Can't go wrong.'" }
      ]
    },

    {
      "id": "mira_repeller_shop",
      "event": "npc_interacted",
      "filter": { "npcType": "component_dealer_mira" },
      "conditions": [
        { "hasFlag": "bought_from_mira" },
        { "hasFlag": "pest_quest_started" },
        { "not": { "hasFlag": "pest_quest_complete" } },
        { "not": { "hasItem": "emp_charge" } }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "mira_repeller", "prompt": "Mira notices you looking at her specialty items. 'I heard about the drone problem on the terrace. I've got something for that.'", "options": [
          { "label": "EMP Charge", "description": "A single-use electromagnetic pulse that fries nearby electronics.", "value": "buy" },
          { "label": "No thanks", "description": "Maybe you'll get one somewhere else.", "value": "decline" }
        ]}
      ]
    },
    {
      "id": "mira_buy_repeller",
      "event": "choice_made",
      "filter": { "choiceId": "mira_repeller", "value": "buy" },
      "actions": [
        { "type": "giveItem", "itemType": "emp_charge" },
        { "type": "grantXp", "amount": 5 },
        { "type": "showMessage", "text": "Mira hands over a small device with a mesh speaker. 'Tuned to the frequency that mites hate. Give it to Sera — she'll know what to do with it.'" }
      ]
    }
  ]
