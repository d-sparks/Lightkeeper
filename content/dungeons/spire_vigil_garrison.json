  "triggers": [
      {
        "id": "garrison_enter",
        "event": "room_entered",
        "actions": [
          {
            "type": "showMessage",
            "lines": [
              "The Spire's outer galleries have been converted into a military garrison. Weapon racks line the walls between ancient geometric carvings. Ammunition crates sit on floors that predate human history.",
              "The contrast is stark \u2014 crude metalwork bolted onto architecture of impossible precision. The raiders are using this place, but they don't understand it.",
              "A Luddite Warlord holds command here. The inner fortress lies beyond this garrison."
            ]
          }
        ],
        "once": true,
        "conditions": [
          {
            "noHostilesInRoom": true
          }
        ]
      },
      {
        "id": "garrison_enter_cleared",
        "event": "room_cleared",
        "actions": [
          {
            "type": "showMessage",
            "lines": [
              "The Spire's outer galleries have been converted into a military garrison. Weapon racks line the walls between ancient geometric carvings. Ammunition crates sit on floors that predate human history.",
              "The contrast is stark \u2014 crude metalwork bolted onto architecture of impossible precision. The raiders are using this place, but they don't understand it.",
              "A Luddite Warlord holds command here. The inner fortress lies beyond this garrison."
            ]
          }
        ],
        "once": true
      },
      {
        "id": "garrison_entry_gate",
        "event": "door_interacted",
        "filter": {
          "tileX": 8,
          "tileY": 3
        },
        "actions": [
          {
            "type": "showMessage",
            "text": "The crystal gate slides open. The raiders haven't figured out how to lock these \u2014 the Spire only responds to Sol-frequency light."
          }
        ],
        "once": true
      },
      {
        "id": "garrison_warlord_killed",
        "event": "monster_killed",
        "filter": {
          "monsterType": "spire_garrison_warlord"
        },
        "actions": [
          {
            "type": "setFlag",
            "flag": "garrison_warlord_killed"
          },
          {
            "type": "grantXp",
            "amount": 60
          },
          {
            "type": "showMessage",
            "lines": [
              "The Warlord collapses. The remaining raiders scatter \u2014 without leadership, the garrison's discipline crumbles.",
              "The barricade blocking the inner fortress can be cleared now. Dural Voss and his personal guard wait below."
            ]
          },
          {
            "type": "setQuestObjective",
            "text": "Push deeper into the Spire \u2014 Dural Voss awaits"
          }
        ],
        "once": true
      },
      {
        "id": "garrison_inner_gate",
        "event": "door_interacted",
        "filter": {
          "tileX": 16,
          "tileY": 14
        },
        "conditions": [
          {
            "not": {
              "hasFlag": "garrison_warlord_killed"
            }
          }
        ],
        "actions": [
          {
            "type": "showMessage",
            "text": "The crystal gate won't open \u2014 the Warlord's forces have barricaded the far side. Eliminate the garrison commander first."
          }
        ]
      },
      {
        "id": "garrison_battle_plans_found",
        "event": "item_picked_up",
        "filter": {
          "itemType": "garrison_battle_plans"
        },
        "actions": [
          {
            "type": "setFlag",
            "flag": "found_battle_plans"
          },
          {
            "type": "showMessage",
            "lines": [
              "Battle plans scratched onto salvaged metal plates. You can piece together Voss's strategy:",
              "The Spire runs deep \u2014 far deeper than the raiders expected. The outer defenses, watchtower, and this garrison hold the upper levels. Voss himself commands the sanctum far below. Below that...",
              "The plans stop. Voss has drawn a line across the page and written one word: 'SEALED.' Whatever lies beneath the sanctum, even Voss hasn't breached it.",
              "But the plans include energy readings from below \u2014 massive, regular pulses that match no known power source. Voss has been trying to break through for weeks."
            ]
          }
        ],
        "once": true
      },
      {
        "id": "chest_loot_garrison",
        "event": "door_interacted",
        "filter": {
          "tileName": "chest_closed"
        },
        "actions": [
          {
            "type": "rollLootTable",
            "lootTable": "spire_vigil_chest"
          }
        ]
      },
      {
        "id": "mark_garrison_visited",
        "event": "room_entered",
        "actions": [
          {
            "type": "setFlag",
            "flag": "visited_spire_garrison",
            "scope": "player"
          }
        ],
        "once": true
      }
    ]
