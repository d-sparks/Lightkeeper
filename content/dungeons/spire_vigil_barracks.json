      "filter": { "tileX": 11, "tileY": 9 },
      "conditions": [
        { "not": { "hasFlag": "barracks_ambush_sprung" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "barracks_ambush_sprung" },
        { "type": "showMessage", "lines": [
          "A sharp whistle pierces the air — ambush! Raiders pour from concealed alcoves on all sides.",
          "Feral hounds snarl and lunge from the shadows. This was a trap, and you walked right into it."
        ]}
      ],
      "once": true
    },
