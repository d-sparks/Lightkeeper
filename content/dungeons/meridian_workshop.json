  "triggers": [
    {
      "id": "enter_workshop",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "The Workshop District. The clang of hammers and the hiss of soldering fills the air. Workbenches line the walls, covered in tools and half-finished projects.",
          "The smell of hot metal and solder — the smell of things being made."
        ]}
      ],
      "once": true
    },
    {
      "id": "yun_crafting_tutorial",
      "event": "npc_interacted",
      "filter": { "npcType": "crafter_yun" },
      "conditions": [
        { "hasItem": "copper_coil" },
        { "hasItem": "umbracite" },
        { "not": { "hasFlag": "yun_tutorial_complete" } }
      ],
      "actions": [
        { "type": "removeItem", "itemType": "copper_coil" },
        { "type": "removeItem", "itemType": "umbracite" },
        { "type": "setFlag", "flag": "yun_tutorial_complete" },
        { "type": "grantXp", "amount": 40 },
        { "type": "showMessage", "lines": [
          "Yun takes the materials and lays them out on the workbench. 'Good. Let me show you how this works.'",
          "'The Umbracite forms the energy matrix. The copper coils distribute the charge. When you get Stabilizing Resin from your homestead plants, you'll have everything you need.'",
          "'For now, I'll put these toward your first battery. Come back with the resin when your homestead is producing.'",
          "'And one more thing — the Array could make these batteries themselves. They choose not to. Ask yourself why an all-powerful automated system wants humanity dependent on them for power.'"
        ]}
      ],
      "once": true
    },
    {
      "id": "davi_wrench_found",
      "event": "item_picked_up",
      "filter": { "itemType": "calibration_wrench" },
      "actions": [
        { "type": "showMessage", "text": "A calibration wrench with 'DAVI' scratched into the handle. Someone's looking for this." },
        { "type": "setFlag", "flag": "found_davi_wrench" }
      ]
    },
    {
      "id": "davi_wrench_return",
      "event": "npc_interacted",
      "filter": { "npcType": "apprentice_davi" },
      "conditions": [
        { "hasItem": "calibration_wrench" },
        { "not": { "hasFlag": "davi_wrench_returned" } }
      ],
      "actions": [
        { "type": "removeItem", "itemType": "calibration_wrench" },
        { "type": "giveItem", "itemType": "copper_coil", "count": 2 },
        { "type": "setFlag", "flag": "davi_wrench_returned" },
        { "type": "grantXp", "amount": 15 },
        { "type": "showMessage", "lines": [
          "Davi's face lights up. 'My wrench! You're a lifesaver!'",
          "'Here — take these Copper Coils. I was saving them, but you need them more than I do.'"
        ]}
      ],
      "once": true
    }
  ]
