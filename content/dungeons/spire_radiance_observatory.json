  "triggers": [
      {
        "id": "observatory_enter",
        "event": "room_entered",
        "actions": [
          {
            "type": "showMessage",
            "lines": [
              "A crystalline observatory opens around you \u2014 a vast chamber where ancient mirrors of shaped crystal hang suspended at precise angles around a solar conduit ring. The Underlumen used directed light to power this chamber's mechanisms.",
              "The mirrors still gleam, their surfaces untouched by the centuries. But the light source that once fed them has long gone dark. A photosensor near the lower passage waits for the correct beam alignment.",
              "If you could generate a focused beam of light and position it to reflect through the mirror array, the observatory's ancient mechanisms might respond. The mirrors trace a path from west to south to east."
            ]
          }
        ],
        "once": true,
        "conditions": [
          {
            "noHostilesInRoom": true
          }
        ]
      },
      {
        "id": "observatory_enter_cleared",
        "event": "room_cleared",
        "actions": [
          {
            "type": "showMessage",
            "lines": [
              "A crystalline observatory opens around you \u2014 a vast chamber where ancient mirrors of shaped crystal hang suspended at precise angles around a solar conduit ring. The Underlumen used directed light to power this chamber's mechanisms.",
              "The mirrors still gleam, their surfaces untouched by the centuries. But the light source that once fed them has long gone dark. A photosensor near the lower passage waits for the correct beam alignment.",
              "If you could generate a focused beam of light and position it to reflect through the mirror array, the observatory's ancient mechanisms might respond. The mirrors trace a path from west to south to east."
            ]
          }
        ],
        "once": true
      },
      {
        "id": "beam_puzzle_solved",
        "event": "photosensor_activated",
        "filter": { "sensorId": "observatory_beam_sensor" },
        "actions": [
          {
            "type": "setFlag",
            "flag": "observatory_puzzle_complete"
          },
          {
            "type": "setFlag",
            "flag": "radiance_conduits_aligned"
          },
          {
            "type": "showMessage",
            "lines": [
              "The reflected beam strikes the photosensor with pinpoint accuracy. Ancient crystal circuits flare to life as focused light races through channels carved into the floor.",
              "The observatory awakens. Light cascades through every crystal surface, and for a brief moment you see it \u2014 a map of the Spire's energy architecture rendered in pure light. The sealed passage trembles and opens.",
              "The core is not just below you. It is everywhere \u2014 threaded through every wall, every crystal, every conduit. The entire Spire is the core. And it is waking up."
            ]
          },
          {
            "type": "grantXp",
            "amount": 40
          }
        ],
        "once": true
      },
      {
        "id": "beam_puzzle_interrupted",
        "event": "photosensor_deactivated",
        "filter": { "sensorId": "observatory_beam_sensor" },
        "conditions": [
          {
            "not": {
              "hasFlag": "observatory_puzzle_complete"
            }
          }
        ],
        "actions": [
          {
            "type": "showMessage",
            "text": "The beam alignment breaks. The photosensor dims and the passage seals once more. The mirrors await a steady light source."
          }
        ]
      }
    ]
