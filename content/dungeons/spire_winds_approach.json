  "triggers": [
    {
      "id": "approach_enter",
      "event": "room_entered",
      "conditions": [{ "not": { "hasFlag": "visited_spire_winds" } }],
      "actions": [
        { "type": "showMessage", "lines": [
          "The Monument of Winds rises ahead — that ancient landmark you passed in Meridian, now bristling with Bulwark fortifications. Sandbags, razor wire, and prefab guard posts ring the base.",
          "The Compact military has turned a cultural monument into a forward operating base. Searchlights sweep the perimeter. You can hear the hum of patrol drones overhead.",
          "Asha Denn's intelligence was right: the Bulwark is digging into the Monument's foundations. Whatever they've found down there, they're not letting anyone near it."
        ]},
        { "type": "setFlag", "flag": "visited_spire_winds" },
        { "type": "setFlag", "flag": "spire_winds_discovered" }
      ],
      "once": true
    },
    {
      "id": "control_panel_interact",
      "event": "door_interacted",
      "filter": { "tileName": "control_panel" },
      "conditions": [{ "not": { "hasFlag": "fortress_power_disabled" } }],
      "actions": [
        { "type": "setFlag", "flag": "fortress_power_disabled" },
        { "type": "showMessage", "lines": [
          "The panel sparks as you reroute the power grid. Warning klaxons sound briefly, then die. The fortress perimeter lights flicker and go dark.",
          "MERIDIAN-7's override codes worked. The inner security systems are down."
        ]},
        { "type": "grantXp", "amount": 30 }
      ],
      "once": true
    },
    {
      "id": "supply_crate_loot",
      "event": "door_interacted",
      "filter": { "tileName": "supply_crate_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "bulwark_common" },
        { "type": "showMessage", "text": "Bulwark supply crate. Standard military provisions." }
      ]
    },
    {
      "id": "chest_loot",
      "event": "door_interacted",
      "filter": { "tileName": "chest_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "bulwark_common" },
        { "type": "showMessage", "text": "A locked equipment case. Contains Bulwark-issue gear." }
      ]
    },
    {
      "id": "venn_flag",
      "event": "npc_interacted",
      "filter": { "npcType": "corporal_venn" },
      "conditions": [{ "not": { "hasFlag": "met_corporal_venn" } }],
      "actions": [
        { "type": "setFlag", "flag": "met_corporal_venn" },
        { "type": "grantXp", "amount": 20 }
      ],
      "once": true
    }
