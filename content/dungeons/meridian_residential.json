  "triggers": [
    {
      "id": "remove_sable_meridian_no_encounter",
      "event": "room_entered",
      "conditions": [
        { "not": { "hasFlag": "helped_sable" } },
        { "not": { "hasFlag": "sable_not_helped" } }
      ],
      "actions": [
        { "type": "removeEntity", "entityType": "npc", "npcType": "sable_meridian" }
      ]
    },
    {
      "id": "fen_recognized",
      "event": "npc_interacted",
      "filter": { "npcType": "fen_maro" },
      "conditions": [
        { "hasFlag": "found_basement_note" },
        { "not": { "hasFlag": "fen_letter_accepted" } }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "fen_letter", "prompt": "Fen Maro recognizes you from their journal. They offer you a letter to deliver to Warden Holt at Outpost Balor.", "options": [
          { "label": "Accept", "description": "Take Fen's letter to Warden Holt. Fen will also mark a supply cache location.", "value": "accept" },
          { "label": "Decline", "description": "You're not heading back to Balor anytime soon.", "value": "decline" }
        ]}
      ],
      "once": true
    },
    {
      "id": "fen_letter_accept",
      "event": "choice_made",
      "filter": { "choiceId": "fen_letter", "value": "accept" },
      "actions": [
        { "type": "giveItem", "itemType": "fens_letter" },
        { "type": "setFlag", "flag": "fen_letter_accepted" },
        { "type": "grantXp", "amount": 15 },
        { "type": "showMessage", "lines": [
          "Fen presses the worn envelope into your hands. Their fingers tremble slightly.",
          "'Thank you. And the cache — it's near the old watchtower, hidden in a collapsed section of wall. My squad's gear. Better than anything in the shops.'",
          "'Tell Holt I'm sorry. That's all I ask.'"
        ]}
      ]
    },
    {
      "id": "fen_letter_decline",
      "event": "choice_made",
      "filter": { "choiceId": "fen_letter", "value": "decline" },
      "actions": [
        { "type": "showMessage", "text": "Fen nods slowly. 'I understand. Maybe another time.' They turn back to the window." }
      ]
    },
    {
      "id": "sable_gives_seed",
      "event": "npc_interacted",
      "filter": { "npcType": "sable_meridian" },
      "conditions": [
        { "hasFlag": "helped_sable" },
        { "not": { "hasFlag": "sable_gave_seed" } }
      ],
      "actions": [
        { "type": "giveItem", "itemType": "umbral_seed" },
        { "type": "setFlag", "flag": "sable_gave_seed" },
        { "type": "grantXp", "amount": 25 },
        { "type": "showMessage", "lines": [
          "Sable places a dark, softly pulsing seed in your palm. It's warm to the touch.",
          "'An Umbral Seed. From the deepest Nightside. Where the planet's heartbeat is strongest.'",
          "'I don't know what it'll become in the light. But you should have it. A gift between worlds.'"
        ]}
      ],
      "once": true
    },
    {
      "id": "fen_quest_complete",
      "event": "npc_interacted",
      "filter": { "npcType": "fen_maro" },
      "conditions": [
        { "hasFlag": "fen_letter_delivered" },
        { "hasFlag": "found_fen_cache" },
        { "not": { "hasFlag": "fen_quest_complete" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "fen_quest_complete" },
        { "type": "grantXp", "amount": 50 },
        { "type": "showMessage", "lines": [
          "Fen listens in silence as you describe the cache. The bedrolls in formation. The cold field stove. The team photo.",
          "They close their eyes for a long moment. When they open them again, something has shifted.",
          "'You brought their memory back. That's... that's enough. Thank you.'",
          "'I know these perimeters better than anyone alive. If you need a guide, or someone to watch your back out there — I'm ready.'"
        ]}
      ],
      "once": true
    },
    {
      "id": "sable_warned_post_secret",
      "event": "npc_interacted",
      "filter": { "npcType": "sable_meridian" },
      "conditions": [
        { "hasFlag": "array_secret_discovered" },
        { "not": { "hasFlag": "sable_warned_about_array" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "sable_warned_about_array" },
        { "type": "grantXp", "amount": 25 },
        { "type": "showMessage", "lines": [
          "You tell Sable what you found inside the Array Deep Processing facility. The synthesis vats. Project Autotroph. The Array's long, patient effort to replicate Ring biology.",
          "She does not look surprised. She looks like someone who has been waiting a very long time to be believed."
        ]}
      ],
      "once": true
    }
  ]
}
