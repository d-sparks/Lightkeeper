  "triggers": [
    {
      "id": "f15_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "Maintenance corridors stretch in a grid pattern — this was the lighthouse's service infrastructure, designed for engineering crews that haven't walked these halls in years.",
            "Ice has crept through every crack, freezing the doors and coating the walls. Emergency lighting still pulses faintly behind the frost."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f15_chest",
      "event": "door_interacted",
      "filter": {
        "tileName": "chest_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "frost_biome_rare"
        }
      ]
    },
    {
      "id": "f15_machinery_1",
      "event": "door_interacted",
      "filter": {
        "tileX": 7,
        "tileY": 1
      },
      "actions": [
        {
          "type": "showMessage",
          "text": "A maintenance log terminal. Last entry: \"Foundation stress sensors triggered at 0247. All readings below Level 3 showing progressive deformation. Chief Engineer Patel ordered full evacuation of sub-basement levels. Nobody argued.\""
        }
      ],
      "once": true
    },
    {
      "id": "f15_machinery_2",
      "event": "door_interacted",
      "filter": {
        "tileX": 14,
        "tileY": 5
      },
      "actions": [
        {
          "type": "showMessage",
          "text": "A frozen monitoring station. The seismograph trace is still visible on the display — a steady 4.7-second pulse, each peak slightly higher than the last. The trace ends when the stylus ran off the top of the chart."
        }
      ],
      "once": true
    },
    {
      "id": "mark_lighthouse_mara_f15_visited",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "visited_lighthouse_mara_f15",
          "scope": "player"
        }
      ],
      "once": true
    }
  ]
