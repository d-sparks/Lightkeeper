      "spawnY": 14
    }
  ],
  "triggers": [
    {
      "id": "perimeter_gate_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "A heavy blast door blocks the way north. The last barrier between the outpost and the open dark.",
            "A weathered soldier stands beside the control panel, rifle slung over one shoulder."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "fenn_opens_gate",
      "event": "npc_interacted",
      "filter": {
        "npcType": "gate_sgt_fenn"
      },
      "conditions": [
        {
          "hasFlag": "received_sol_unit"
        },
        {
          "not": {
            "hasFlag": "fenn_opened_gate"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "fenn_opened_gate"
        },
        {
          "type": "giveItem",
          "itemType": "flare"
        },
        {
          "type": "toggleTile",
          "x": 9,
          "y": 1
        }
      ],
      "once": true
    },
    {
      "id": "fenn_no_sol",
      "event": "npc_interacted",
      "filter": {
        "npcType": "gate_sgt_fenn"
      },
      "conditions": [
        {
          "not": {
            "hasFlag": "received_sol_unit"
          }
        }
      ],
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "Sgt. Fenn looks you over.",
            "\"No Sol Unit? I'm not opening this gate for you. Go back to the outpost and get properly equipped. The dark will eat you alive out there.\""
          ]
        }
      ]
    },
    {
      "id": "gate_auto_open",
      "event": "room_entered",
      "conditions": [
        {
          "hasFlag": "fenn_opened_gate"
        }
      ],
      "actions": [
        {
          "type": "toggleTile",
          "x": 9,
          "y": 1
        }
      ]
    },
    {
      "id": "gate_closes_behind",
      "event": "room_entered",
      "filter": {
        "dungeonId": "perimeter_outer_ring"
      },
      "conditions": [
        {
          "hasFlag": "fenn_opened_gate"
        }
      ],
      "actions": [
        {
          "type": "showMessage",
          "text": "Behind you, the blast door grinds shut with a deep metallic clang. The sound echoes across the dark landscape. There's no going back that way."
        }
      ],
      "once": true
    }
  ]
}
