        ]},
        { "type": "setFlag", "flag": "visited_greenway_farmstead" }
      ],
      "once": true
    },
    {
      "id": "asha_denn_quest_start",
      "event": "npc_interacted",
      "filter": { "npcType": "farmer_dael" },
      "conditions": [
        { "hasFlag": "visited_greenway_farmstead" },
        { "not": { "hasFlag": "supply_sabotage_started" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "supply_sabotage_started" },
        { "type": "showMessage", "lines": [
          "Dael lowers his voice. 'If you really want to help, talk to Councillor Asha Denn in the settlement. She's been organizing resistance.'",
          "'The Bulwark confiscated our winter stores. Without them, the settlement starves. Asha knows where they're keeping everything \u2014 the old grain exchange, east of here.'",
          "QUEST: Greenway Liberation \u2014 Find the supply depot and recover confiscated supplies for the settlement."
        ]},
        { "type": "grantXp", "amount": 15 }
      ],
      "once": true
    },
    {
      "id": "farmstead_crate",
      "event": "door_interacted",
      "filter": { "tileX": 4, "tileY": 18 },
      "actions": [
        { "type": "spawnItem", "itemType": "field_ration_greenway", "x": 3, "y": 18 },
        { "type": "showMessage", "text": "A hidden stash beneath the floorboards. The farmers have been keeping back what they can." }
      ],
      "once": true
    },
    {
      "id": "lissa_depot_key_hint",
      "event": "npc_interacted",
      "filter": { "npcType": "farmer_lissa" },
      "conditions": [
        { "hasFlag": "supply_sabotage_started" },
        { "not": { "hasItem": "depot_access_key" } }
      ],
      "actions": [
        { "type": "showMessage", "lines": [
          "Lissa glances toward the eastern road. 'The engineer on south fence duty leaves his key in a toolbox by the depot entrance. Every shift, same spot.'",
          "'If someone were to borrow it during shift change... well, I wouldn't know anything about that.'"
        ]}
      ]
    }
