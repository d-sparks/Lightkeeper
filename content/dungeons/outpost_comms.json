    {
      "id": "daley_quest_start",
      "event": "npc_interacted",
      "filter": { "npcType": "comms_officer_daley" },
      "conditions": [
        { "not": { "hasFlag": "daley_quest_active" } },
        { "not": { "hasFlag": "comms_restored" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "daley_quest_active" }
      ],
      "once": true
    },
    {
      "id": "daley_comms_restored",
      "event": "npc_interacted",
      "filter": { "npcType": "comms_officer_daley" },
      "conditions": [
        { "hasItem": "circuit_board" },
        { "hasItem": "backup_power_cell" },
        { "not": { "hasFlag": "comms_restored" } }
      ],
      "actions": [
        { "type": "removeItem", "itemType": "circuit_board" },
        { "type": "removeItem", "itemType": "backup_power_cell" },
        { "type": "setFlag", "flag": "comms_restored" },
        { "type": "giveItem", "itemType": "signal_booster_chip" },
        { "type": "showMessage", "text": "Comms partially restored! You received a Signal Booster chip." }
      ],
      "once": true
    }
  ]
