  "triggers": [
    {
      "id": "approach_enter",
      "event": "room_entered",
      "conditions": [{ "not": { "hasFlag": "visited_spire_radiance" } }],
      "actions": [
        { "type": "showMessage", "lines": [
          "The Spire of Radiance rises from the scorched earth like a blade of pure light — the oldest structure on Erith's dayside, now encased in three centuries of Array infrastructure. Cooling towers, processing nodes, and power conduits wrap the ancient stone like parasitic circuitry.",
          "The heat here is staggering. Your sol unit's thermal warnings pulse red. The Array has turned this entire region into a computational furnace, feeding off the Spire's energy output.",
          "This is the Deep Array's crown jewel. Whatever the Array became — whatever it's becoming — started here, at the point where machine intelligence first touched something far older than itself."
        ]},
        { "type": "setFlag", "flag": "visited_spire_radiance" }
      ],
      "once": true
    },
    {
      "id": "control_panel_interact",
      "event": "door_interacted",
      "filter": { "tileName": "control_panel" },
      "conditions": [{ "not": { "hasFlag": "radiance_perimeter_disabled" } }],
      "actions": [
        { "type": "setFlag", "flag": "radiance_perimeter_disabled" },
        { "type": "showMessage", "lines": [
          "The panel flickers as you inject override codes. Warning indicators cascade across the display — then die. The perimeter defense grid powers down.",
          "The Array's automated turret network goes silent. But deeper alarms are already propagating inward. Whatever guards the Nexus knows you're here."
        ]},
        { "type": "grantXp", "amount": 30 }
      ],
      "once": true
    },
    {
      "id": "supply_crate_loot",
      "event": "door_interacted",
      "filter": { "tileName": "supply_crate_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "geothermal_biome_uncommon" },
        { "type": "showMessage", "text": "Array maintenance supplies. Heat-shielded containers holding components designed for machine hands." }
      ]
    },
    {
      "id": "chest_loot",
      "event": "door_interacted",
      "filter": { "tileName": "chest_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "geothermal_biome_uncommon" },
        { "type": "showMessage", "text": "A sealed equipment cache. The components inside shimmer with hybrid circuitry — Array processing lattice interwoven with crystalline structures that predate the machines." }
      ]
    },
    {
      "id": "mark_approach_visited",
      "event": "room_entered",
      "actions": [
        { "type": "setFlag", "flag": "spire_radiance_approach_visited", "scope": "player" }
      ],
      "once": true
    }
  ]
