  "triggers": [
    {
      "id": "core_enter",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "The temperature drops sharply as you descend into the lighthouse's power core. Frost coats every surface in crystalline patterns.",
          "The walls here are wrong. Between the ice, you can see deep fractures in the bedrock — perfectly geometric, radiating outward from somewhere far below. The damage that killed this lighthouse came from underneath."
        ]}
      ],
      "once": true
    },
    {
      "id": "conduit_a_interact",
      "event": "door_interacted",
      "filter": { "tileX": 7, "tileY": 7 },
      "conditions": [
        { "not": { "hasFlag": "mara_conduit_a_activated" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "mara_conduit_a_activated" },
        { "type": "showMessage", "text": "You reroute power through Conduit A. The conduit hums to life, frost melting from its surface. A faint current runs toward the sealed core hatch." }
      ],
      "once": true
    },
    {
      "id": "conduit_b_interact",
      "event": "door_interacted",
      "filter": { "tileX": 11, "tileY": 7 },
      "conditions": [
        { "hasFlag": "mara_conduit_a_activated" },
        { "not": { "hasFlag": "mara_conduits_online" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "mara_conduits_online" },
        { "type": "showMessage", "text": "Conduit B connects. Both power lines are live — the core hatch between them shudders. You can hear mechanisms grinding behind the frost. The hatch can be opened now." }
      ],
      "once": true
    },
    {
      "id": "core_hatch_opened",
      "event": "door_interacted",
      "filter": { "tileX": 9, "tileY": 9 },
      "conditions": [
        { "hasFlag": "mara_conduits_online" }
      ],
      "actions": [
        { "type": "showMessage", "text": "The core hatch grinds open. Below, a narrow shaft leads down to the lighthouse's heart — the lens chamber. The walls of the shaft are covered in geometric fractures, perfectly symmetrical. Something ancient shaped this rock." }
      ],
      "once": true
    },
    {
      "id": "survey_marker_interact",
      "event": "door_interacted",
      "filter": { "tileX": 17, "tileY": 6 },
      "actions": [
        { "type": "showMessage", "lines": [
          "An old geological survey marker, half-buried in frost. Its data screen still flickers:",
          "\"GEOLOGICAL SURVEY — SITE MARA-7 — CLASSIFIED\"",
          "\"Subsurface anomaly detected at 3.2km depth. Readings inconsistent with known geological formations.\"",
          "\"Signal pattern: rhythmic, 4.7 second interval. Magnitude increasing 0.3% per cycle.\"",
          "\"Assessment: NON-NATURAL ORIGIN. Recommend immediate Deep Array survey. Request denied by Meridian Central — 'insufficient priority.'\"",
          "The survey data chip ejects. This should go to someone who understands what's happening beneath the Nightside."
        ]}
      ],
      "once": true
    },
    {
      "id": "boss_defeated",
      "event": "monster_killed",
      "filter": { "monsterType": "shade_stalker_alpha" },
      "actions": [
        { "type": "showMessage", "text": "The Alpha Shade collapses, its form dissolving into cold mist. The core chamber falls silent — only the hum of the power conduits remains." },
        { "type": "spawnItem", "itemType": "shadow_conduit_chip", "x": 9, "y": 12 },
        { "type": "setFlag", "flag": "mara_core_cleared", "scope": "player" }
      ],
      "once": true
    },
    {
      "id": "lighthouse_restored",
      "event": "door_interacted",
      "filter": { "tileName": "chest_closed" },
      "conditions": [
        { "hasFlag": "mara_conduits_online" },
        { "hasFlag": "mara_core_cleared" }
      ],
      "actions": [
        { "type": "setFlag", "flag": "lighthouse_mara_restored", "scope": "player" },
        { "type": "rollLootTable", "lootTable": "frost_biome_rare" },
        { "type": "showMessage", "lines": [
          "You connect the power cell to the lighthouse core. For a moment, nothing happens.",
          "Then light erupts — blinding, warm, cutting through the frost like a blade. The lens above begins to turn, casting its beam across the Nightside for the first time in days.",
          "Lighthouse Mara lives again. But as the light sweeps the deep fractures in the walls, you can see them clearly now: geometric patterns carved into the bedrock, impossibly deep, impossibly precise.",
          "Whatever broke this lighthouse didn't come from outside. It came from below. And the patterns suggest it wasn't destruction — it was emergence."
        ]},
        { "type": "grantXp", "amount": 75 }
      ],
      "once": true
    },
    {
      "id": "chest_loot_core",
      "event": "door_interacted",
      "filter": { "tileName": "chest_closed" },
      "conditions": [
        { "not": { "hasFlag": "mara_conduits_online" } }
      ],
      "actions": [
        { "type": "showMessage", "text": "The core housing is sealed tight. You'll need to restore power through both conduits before the core can be accessed." }
      ]
    },
    {
      "id": "mark_core_visited",
      "event": "room_entered",
      "actions": [
        { "type": "setFlag", "flag": "visited_mara_core", "scope": "player" }
      ],
      "once": true
    }
  ]
}
