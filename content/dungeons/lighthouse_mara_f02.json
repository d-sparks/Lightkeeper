  "triggers": [
    {
      "id": "f02_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "The caverns widen into a frozen gallery. Claw marks score the ice walls — something large has been moving through here.",
            "Ahead, you can hear the clicking of mandibles echoing off frozen stone."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f02_chest",
      "event": "door_interacted",
      "filter": {
        "tileName": "chest_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "frost_biome_common"
        }
      ]
    },
    {
      "id": "f02_descent_warning",
      "event": "room_entered",
      "conditions": [
        { "not": { "hasFlag": "mara_descent_warned" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "mara_descent_warned", "scope": "player" },
        {
          "type": "showMessage",
          "lines": [
            "The air gets colder with every step down. This cavern system runs deep — the keeper's journal mentioned sub-basement levels far below.",
            "Stock up on frost salves. It's a long way to the bottom, and a longer way back."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "mark_lighthouse_mara_f02_visited",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "visited_lighthouse_mara_f02",
          "scope": "player"
        }
      ],
      "once": true
    }
