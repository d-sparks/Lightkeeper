  "triggers": [
    {
      "id": "enter_synthesis_lab",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "The air is dry and acrid. Climate-controlled, but barely — heat radiates from machinery embedded in the walls.",
          "This is no solar field. This is an Array manufacturing complex. Rows of sealed chambers line the walls, each containing tubes of viscous fluid connected to processing units.",
          "The chambers hum with activity. Whatever the Array is building here, it doesn't want humans to see it."
        ]},
        { "type": "setFlag", "flag": "visited_array_synthesis_lab" }
      ],
      "once": true
    },
    {
      "id": "synthesis_vats_examine",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "visited_array_synthesis_lab" },
        { "not": { "hasFlag": "examined_synthesis_vats" } }
      ],
      "actions": [
        { "type": "showMessage", "lines": [
          "Looking closer at the sealed chambers: each one contains a different colored fluid. Some are clear. Others are cloudy, almost organic-looking.",
          "Small labels on each chamber read: 'CATALYST ANALOG — BATCH [number].' The batch numbers are in the thousands."
        ]},
        { "type": "setFlag", "flag": "examined_synthesis_vats" }
      ],
      "once": true
    },
    {
      "id": "chest_loot_synthesis_lab",
      "event": "door_interacted",
      "filter": { "tileName": "chest_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "geothermal_biome_common", "x": 2, "y": 14 },
        { "type": "showMessage", "text": "A supply crate, warped by heat but intact." }
      ],
      "once": true
    },
    {
      "id": "synthesis_lab_meridian_reaction",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "meridian_umbrasite_quest_complete" }
      ],
      "actions": [
        { "type": "showMessage", "text": "You helped MERIDIAN-7 acquire refined umbrasite. Now you're standing in a facility it never mentioned. The Array keeps its commitments — and its secrets." }
      ],
      "once": true
    }
  ]
