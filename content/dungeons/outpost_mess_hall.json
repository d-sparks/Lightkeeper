  "triggers": [
    {
      "id": "mess_hall_welcome",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "text": "The mess hall. Off-duty personnel gather here between shifts. The smell of reheated rations fills the air."
        }
      ],
      "once": true
    },
    {
      "id": "brannigan_start_ration_quest",
      "event": "npc_interacted",
      "filter": {
        "npcType": "mess_cook_brannigan"
      },
      "conditions": [
        {
          "not": {
            "hasFlag": "brannigan_rations_quest"
          }
        },
        {
          "not": {
            "hasFlag": "brannigan_quest_complete"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "brannigan_rations_quest"
        }
      ],
      "once": true
    },
    {
      "id": "brannigan_quest_reward",
      "event": "npc_interacted",
      "filter": {
        "npcType": "mess_cook_brannigan"
      },
      "conditions": [
        {
          "hasFlag": "found_basement_hideout"
        },
        {
          "not": {
            "hasFlag": "brannigan_quest_complete"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "brannigan_quest_complete"
        },
        {
          "type": "giveItem",
          "itemType": "ration_pack"
        },
        {
          "type": "giveItem",
          "itemType": "ration_pack"
        },
        {
          "type": "giveItem",
          "itemType": "ration_pack"
        },
        {
          "type": "showMessage",
          "text": "Cook Brannigan gives you 3 Ration Packs."
        }
      ],
      "once": true
    },
    {
      "id": "kade_gives_intel",
      "event": "npc_interacted",
      "filter": {
        "npcType": "mess_surveyor_kade"
      },
      "conditions": [
        {
          "not": {
            "hasFlag": "kade_intel_received"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "kade_intel_received"
        },
        {
          "type": "showMessage",
          "text": "Surveyor Kade marks known paths on your map. This intel will help you navigate the perimeter."
        }
      ],
      "once": true
    },
    {
      "id": "vasik_quest_start",
      "event": "npc_interacted",
      "filter": {
        "npcType": "infirmary_dr_vasik"
      },
      "conditions": [
        {
          "not": {
            "hasFlag": "vasik_asked_for_moss"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "vasik_asked_for_moss"
        }
      ],
      "once": true
    },
    {
      "id": "lore_soldiers_journal_pickup",
      "event": "item_picked_up",
      "filter": {
        "itemType": "lore_soldiers_journal"
      },
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "A soldier's personal journal left on a bench. One entry stands out:",
            "'Caught a Luddite today. Expected a savage — that's what briefings say. She was carrying seeds. Actual seeds, in labeled pouches, like a botanist on a field trip.'",
            "'Said her people grow things in the dark. Fungi, moss, things that glow. Sgt. Fenn sent her to lockup. I keep thinking about those seeds.'"
          ]
        }
      ],
      "once": true
    },
    {
      "id": "notice_board_interaction",
      "event": "room_entered",
      "conditions": [
        {
          "hasFlag": "received_sol_unit"
        },
        {
          "not": {
            "hasFlag": "checked_notice_board"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "checked_notice_board"
        },
        {
          "type": "showMessage",
          "lines": [
            "A notice board on the wall catches your eye. Several bounty postings are pinned up:",
            "WANTED: Dusk Crawlers sighted on perimeter. Eliminate on sight. Reward: Medical supplies.",
            "NOTICE: Missing supplies from mess hall storage. Report any suspicious activity to Cook Brannigan.",
            "ADVISORY: All personnel heading beyond the perimeter must check in with Surveyor Kade for updated route maps."
          ]
        }
      ],
      "once": true
    }
  ]
}
