  "triggers": [
    {
      "id": "f17_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "The conduit hall — power routing infrastructure for the entire lighthouse. Heavy cables run through frozen channels, all dark.",
            "The geometric fractures have pushed through the floor here, cracking metal panels and bending conduit brackets. The infrastructure was built over something it was never meant to contain."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f17_chest",
      "event": "door_interacted",
      "filter": {
        "tileName": "chest_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "frost_biome_rare"
        }
      ]
    },
    {
      "id": "f17_machinery",
      "event": "door_interacted",
      "filter": {
        "tileX": 10,
        "tileY": 5
      },
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "A routing control panel, cracked but functional. The display shows the lighthouse's power grid — every conduit path mapped in precise detail.",
            "At the bottom of the schematic, below the deepest planned level, someone has hand-drawn an annotation: \"UNKNOWN STRUCTURE — DO NOT ROUTE POWER HERE — Patel.\"",
            "The annotation is circled three times."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "mark_lighthouse_mara_f17_visited",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "visited_lighthouse_mara_f17",
          "scope": "player"
        }
      ],
      "once": true
    }
