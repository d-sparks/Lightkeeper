  "triggers": [
    {
      "id": "f08_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "A frozen waterfall dominates the cavern — a curtain of ice suspended in mid-cascade, perfectly still. Behind it, you can see dark shapes frozen in the flow.",
            "The water froze too fast. This wasn't gradual cooling. Something flash-froze this entire chamber in an instant."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f08_chest",
      "event": "door_interacted",
      "filter": {
        "tileName": "chest_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "frost_biome_uncommon"
        }
      ]
    },
    {
      "id": "f08_frozen_infrastructure",
      "event": "room_entered",
      "conditions": [
        { "not": { "hasFlag": "mara_f08_instability_seen" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "mara_f08_instability_seen", "scope": "player" },
        {
          "type": "showMessage",
          "text": "Frozen pipes jut from the waterfall wall — old infrastructure, swallowed by ice. The flash-freeze that created this must have caught the whole sub-basement at once."
        }
      ],
      "once": true
    },
    {
      "id": "mark_lighthouse_mara_f08_visited",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "visited_lighthouse_mara_f08",
          "scope": "player"
        }
      ],
      "once": true
    }
  ],
