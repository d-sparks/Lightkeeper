      "conditions": [
        { "not": { "hasFlag": "underlumen_puzzle_1_solved" } }
      ],
      "actions": [
        { "type": "showMessage", "text": "The pedestal is dark and unresponsive. The upper chamber's puzzle must be completed first." }
      ]
    },
    {
