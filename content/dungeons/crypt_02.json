  "triggers": [
    {
      "id": "mark_visited_crypt_02",
      "event": "room_entered",
      "actions": [
        { "type": "setFlag", "flag": "visited_crypt_02", "scope": "player" }
      ],
      "once": true
    },
    {
      "id": "spawn_moss_if_keeper_told",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "keeper_told_moss_location" },
        { "not": { "hasFlag": "moss_spawned" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "moss_spawned" },
        { "type": "spawnItem", "itemType": "bioluminescent_moss", "x": 12, "y": 10 },
        { "type": "showMessage", "text": "You spot a patch of softly glowing moss along the far wall — just where the Old Keeper said it would be." }
      ],
      "once": true
    },
    {
      "id": "moss_pickup_message",
      "event": "item_picked_up",
      "filter": { "itemType": "bioluminescent_moss" },
      "actions": [
        { "type": "showMessage", "text": "You carefully harvest the bioluminescent moss. Dr. Vasik can use this to make the healing salve." }
      ],
      "once": true
    },
    {
      "id": "crypt_02_track_kills",
      "event": "monster_killed",
      "conditions": [
        { "not": { "hasFlag": "crypt_02_cleared" } }
      ],
      "actions": [
        { "type": "incrementFlag", "flag": "crypt_02_kills", "scope": "player" }
      ]
    },
    {
      "id": "crypt_02_clear_reward",
      "event": "monster_killed",
      "conditions": [
        { "flagGreaterThan": { "flag": "crypt_02_kills", "value": 4 } },
        { "not": { "hasFlag": "crypt_02_cleared" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "crypt_02_cleared", "scope": "player" },
        { "type": "showMessage", "lines": [
          "As the last creature falls, you hear a grinding sound from the far wall. A section of stone slides aside, revealing a hidden alcove.",
          "Inside: a Sol Unit frame unlike anything you've seen at the outpost. Dark-tuned circuitry, Unbounded markings scratched into the casing. Someone stashed this here — an engineer who knew the crypts.",
          "The Nightcaster Frame. Built for hitting hard in the deep dark."
        ]},
        { "type": "spawnItem", "itemType": "nightcaster_frame", "x": 12, "y": 6 },
        { "type": "grantXp", "amount": 40 }
      ],
      "once": true
    },
    {
      "id": "nightcaster_frame_pickup",
      "event": "item_picked_up",
      "filter": { "itemType": "nightcaster_frame" },
      "actions": [
        { "type": "setFlag", "flag": "has_nightcaster_frame", "scope": "player" },
        { "type": "showMessage", "lines": [
          "The Nightcaster Frame hums as you pick it up. Its dark-tuned emitters are already calibrated — ready to amplify damage by 20%.",
          "Compact 5x5 grid with cold resistance. An Unbounded raider's weapon of choice."
        ]}
      ],
      "once": true
    },
    {
      "id": "spawn_etching_if_keeper_asked",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "keeper_asked_for_etching" },
        { "not": { "hasFlag": "etching_spawned" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "etching_spawned" },
        { "type": "spawnItem", "itemType": "underlumen_etching", "x": 6, "y": 9 },
        { "type": "showMessage", "text": "Near a collapsed alcove along the far wall, you spot something half-buried in rubble — a stone tablet, just where the Old Keeper described." }
      ],
      "once": true
    },
    {
      "id": "etching_pickup_message",
      "event": "item_picked_up",
      "filter": { "itemType": "underlumen_etching" },
      "actions": [
        { "type": "showMessage", "lines": [
          "The tablet is heavier than it looks. Its surface is covered in precise geometric etchings — spirals, nested hexagons, branching lines that resemble root networks.",
          "The markings pulse with a faint warmth when your Sol Unit passes over them. Whatever made these was not human.",
          "The Old Keeper will want to see this."
        ]},
        { "type": "grantXp", "amount": 25 }
      ],
      "once": true
    }
  ]
