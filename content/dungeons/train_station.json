  "triggers": [
    {
      "id": "umbracite_pickup_hint",
      "event": "item_picked_up",
      "filter": { "itemType": "umbracite" },
      "conditions": [
        { "not": { "hasFlag": "umbracite_hint_shown" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "umbracite_hint_shown" },
        { "type": "showMessage", "lines": [
          "Umbracite — a dense crystallized energy mineral. Rare out here.",
          "MERIDIAN-7 at the terminal across the platform accepts umbracite in exchange for solar infrastructure and Sol components."
        ]}
      ],
      "once": true
    },
    {
      "id": "enter_train_station",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "The train station. Working emergency lights bathe the platform in amber warmth. After the endless dark, it feels like sanctuary.",
          "A departure board on the wall reads: NEXT TRAIN TO MERIDIAN CITY — DELAYED. A tech works at a charging terminal to the left."
        ]}
      ],
      "once": true
    },
    {
      "id": "yara_quest_start",
      "event": "npc_interacted",
      "filter": { "npcType": "station_tech_yara" },
      "conditions": [
        { "not": { "hasFlag": "yara_junction_quest" } },
        { "not": { "hasFlag": "junction_cleared" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "yara_junction_quest" }
      ],
      "once": true
    },
    {
      "id": "yara_gives_transit_pass",
      "event": "npc_interacted",
      "filter": { "npcType": "station_tech_yara" },
      "conditions": [
        { "hasFlag": "junction_cleared" },
        { "not": { "hasFlag": "has_transit_pass" } }
      ],
      "actions": [
        { "type": "giveItem", "itemType": "transit_pass" },
        { "type": "setFlag", "flag": "has_transit_pass" },
        { "type": "toggleTile", "x": 12, "y": 1 },
        { "type": "showMessage", "text": "The departure board flickers and updates: NEXT TRAIN TO MERIDIAN CITY — BOARDING. The platform gate clicks open." }
      ],
      "once": true
    },
    {
      "id": "transit_gate_auto_open",
      "event": "room_entered",
      "conditions": [{ "hasFlag": "has_transit_pass" }],
      "actions": [
        { "type": "toggleTile", "x": 12, "y": 1 }
      ]
    },
    {
      "id": "charge_sol_at_station",
      "event": "npc_interacted",
      "filter": { "npcType": "station_tech_yara" },
      "conditions": [
        { "hasFlag": "received_sol_unit" }
      ],
      "actions": [
        { "type": "setEnergy", "percent": 100 },
        { "type": "setFlag", "flag": "charged_at_station" }
      ]
    },
    {
      "id": "meridian_umbracite_trade",
      "event": "npc_interacted",
      "filter": { "npcType": "meridian_7" },
      "conditions": [
        { "hasItem": "umbracite" },
        { "not": { "hasFlag": "traded_umbracite_meridian" } }
      ],
      "actions": [
        { "type": "removeItem", "itemType": "umbracite" },
        { "type": "giveStructure", "structureId": "solar_panel" },
        { "type": "giveItem", "itemType": "sol_shield_chip" },
        { "type": "setFlag", "flag": "traded_umbracite_meridian" },
        { "type": "showMessage", "lines": [
          "MERIDIAN-7 accepts the umbracite. A solar panel deploys on the dayside.",
          "The terminal also produces a crystalline chip — a Sol Shield Emitter. Your second ability."
        ]}
      ],
      "once": true
    },
    {
      "id": "meridian_open_automation",
      "event": "npc_interacted",
      "filter": { "npcType": "meridian_7" },
      "conditions": [
        { "hasFlag": "traded_umbracite_meridian" },
        { "not": { "hasFlag": "automation_established" } }
      ],
      "actions": [
        { "type": "openAutomation" }
      ]
    },
    {
      "id": "meridian_menu_endgame",
      "event": "npc_interacted",
      "filter": { "npcType": "meridian_7" },
      "conditions": [
        { "hasFlag": "traded_umbracite_meridian" },
        { "hasFlag": "automation_established" },
        { "hasFlag": "endgame_active" }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "meridian_menu", "prompt": "MERIDIAN-7: SELECT INTERFACE", "speaker": "MERIDIAN-7", "options": [
          { "label": "Manage Automation", "value": "open_automation" },
          { "label": "Exchange (Buy / Sell)", "value": "open_shop" },
          { "label": "Fabrication", "value": "open_craft" }
        ]}
      ]
    },
    {
      "id": "meridian_menu",
      "event": "npc_interacted",
      "filter": { "npcType": "meridian_7" },
      "conditions": [
        { "hasFlag": "traded_umbracite_meridian" },
        { "hasFlag": "automation_established" },
        { "not": { "hasFlag": "endgame_active" } }
      ],
      "actions": [
        { "type": "showChoice", "choiceId": "meridian_menu", "prompt": "MERIDIAN-7: SELECT INTERFACE", "speaker": "MERIDIAN-7", "options": [
          { "label": "Manage Automation", "value": "open_automation" },
          { "label": "Exchange (Buy / Sell)", "value": "open_shop" }
        ]}
      ]
    },
    {
      "id": "board_train_flag",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "has_transit_pass" },
        { "not": { "hasFlag": "boarded_train" } }
      ],
      "actions": [
        { "type": "showMessage", "text": "The platform gate is open. The train waits at the far end — step through to board." }
      ]
    },
    {
      "id": "remove_sable_if_not_met",
      "event": "room_entered",
      "conditions": [
        { "not": { "hasFlag": "helped_sable" } },
        { "not": { "hasFlag": "sable_not_helped" } }
      ],
      "actions": [
        { "type": "removeEntity", "entityType": "npc", "npcType": "sable_station" }
      ]
    }
  ]
}
