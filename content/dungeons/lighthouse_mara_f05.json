  "triggers": [
    {
      "id": "f05_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "The cavern opens into a natural grotto studded with ice crystals. They catch your sol unit's glow and fracture it into a thousand cold pinpoints.",
            "Something about the crystal formations feels wrong. The facets are too regular — not grown, but cut. By what, you can't imagine."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f05_chest",
      "event": "door_interacted",
      "filter": {
        "tileName": "chest_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "frost_biome_uncommon"
        }
      ]
    },
    {
      "id": "f05_crystal_clue",
      "event": "room_entered",
      "conditions": [
        {
          "not": {
            "hasFlag": "mara_crystal_clue"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "mara_crystal_clue",
          "scope": "player"
        },
        {
          "type": "showMessage",
          "lines": [
            "You feel it now — a low vibration in the floor, rhythmic and constant. Every 4.7 seconds, like a heartbeat. The crystals resonate with each pulse.",
            "Someone left a supply cache near the eastern wall. Frost salves and a medkit, still sealed. Whatever crew cached these didn't come back for them."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f05_crystal_shatter",
      "event": "room_entered",
      "conditions": [
        { "not": { "hasFlag": "mara_f05_instability_seen" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "mara_f05_instability_seen", "scope": "player" },
        {
          "type": "showMessage",
          "text": "A crystal column shatters as you watch, spraying frozen shards across the grotto floor. The vibrations from below are getting stronger — the formations can't hold."
        }
      ],
      "once": true
    },
    {
      "id": "mark_lighthouse_mara_f05_visited",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "visited_lighthouse_mara_f05",
          "scope": "player"
        }
      ],
      "once": true
    }
  ],
  "sim_passthrough": true
