  "triggers": [
    {
      "id": "infirmary_welcome",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "text": "The infirmary. Clean but cramped. A wounded soldier lies on a cot behind a partition."
        }
      ],
      "once": true
    },
    {
      "id": "vasik_quest_start_infirmary",
      "event": "npc_interacted",
      "filter": {
        "npcType": "infirmary_dr_vasik"
      },
      "conditions": [
        {
          "not": {
            "hasFlag": "vasik_asked_for_moss"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "vasik_asked_for_moss"
        }
      ],
      "once": true
    },
    {
      "id": "vasik_receives_moss",
      "event": "npc_interacted",
      "filter": {
        "npcType": "infirmary_dr_vasik"
      },
      "conditions": [
        {
          "hasItem": "bioluminescent_moss"
        },
        {
          "not": {
            "hasFlag": "vasik_quest_complete"
          }
        }
      ],
      "actions": [
        {
          "type": "removeItem",
          "itemType": "bioluminescent_moss"
        },
        {
          "type": "setFlag",
          "flag": "vasik_quest_complete"
        },
        {
          "type": "giveItem",
          "itemType": "field_medkit"
        },
        {
          "type": "giveItem",
          "itemType": "field_medkit"
        },
        {
          "type": "showMessage",
          "lines": [
            "Dr. Vasik prepares the healing salve and applies it to Tannis's wounds.",
            "She teaches you how to craft Field Medkits \u2014 a significant improvement over basic bandages.",
            "You received 2 Field Medkits."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "tannis_dog_tags_return",
      "event": "npc_interacted",
      "filter": {
        "npcType": "infirmary_pvt_tannis"
      },
      "conditions": [
        {
          "hasItem": "tannis_dog_tags"
        }
      ],
      "actions": [
        {
          "type": "removeItem",
          "itemType": "tannis_dog_tags"
        },
        {
          "type": "giveItem",
          "itemType": "reinforced_battery_chip"
        },
        {
          "type": "setFlag",
          "flag": "returned_tannis_tags"
        },
        {
          "type": "showMessage",
          "text": "Tannis takes the dog tags with trembling hands. After a long silence, he presses a modified battery casing into your palm. \"It was Dolan's. Take it.\""
        }
      ],
      "once": true
    },
    {
      "id": "vasik_preserves_samples",
      "event": "npc_interacted",
      "filter": {
        "npcType": "infirmary_dr_vasik"
      },
      "conditions": [
        {
          "hasItem": "biological_samples"
        },
        {
          "hasFlag": "vasik_quest_complete"
        },
        {
          "not": {
            "hasFlag": "samples_preserved"
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "samples_preserved"
        },
        {
          "type": "grantXp",
          "amount": 15
        },
        {
          "type": "showMessage",
          "text": "Dr. Vasik carefully preserves the biological samples using her medical compounds. 'Properly sealed and temperature-stabilized. Councillor Denn will get much better data from these.'"
        }
      ],
      "once": true
    },
    {
      "id": "crate_loot_infirmary",
      "event": "door_interacted",
      "filter": {
        "tileName": "crate_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "outpost_biome_common"
        }
      ]
    }
  ]
}