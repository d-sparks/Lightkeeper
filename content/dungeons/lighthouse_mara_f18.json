  "triggers": [
    {
      "id": "f18_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "You see it. The breach.",
            "The floor of the sub-basement has been pushed upward — metal panels bent like paper, bedrock cracked open from below. At the center, a perfect geometric aperture, ringed with fracture patterns that radiate outward like a frozen shockwave.",
            "This is where it came through. Whatever disrupted Lighthouse Mara didn't attack from outside. It emerged. It pushed up through two kilometers of bedrock and broke through the foundation like it was nothing.",
            "The geometric patterns match nothing in any engineering database. But they match the Spire architecture you saw in the Nightside surveys. This is Underlumen work."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f18_chest",
      "event": "door_interacted",
      "filter": {
        "tileName": "chest_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "frost_biome_rare"
        }
      ]
    },
    {
      "id": "f18_machinery_1",
      "event": "door_interacted",
      "filter": {
        "tileX": 9,
        "tileY": 2
      },
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "A smashed monitoring console. The final log is frozen on screen:",
            "\"0302 — CATASTROPHIC STRUCTURAL FAILURE LEVEL 4. THE FLOOR IS — it's opening. The floor is opening. It's geometric. It's precise. This isn't an earthquake, this is — oh god. Something is coming up.\"",
            "The log ends."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f18_machinery_2",
      "event": "door_interacted",
      "filter": {
        "tileX": 22,
        "tileY": 2
      },
      "actions": [
        {
          "type": "showMessage",
          "text": "An energy sensor array, still recording. The readings are off every scale — the breach point is emitting a steady harmonic at frequencies that match documented Spire energy signatures. Whatever is beneath this lighthouse is connected to the planetary network."
        }
      ],
      "once": true
    },
    {
      "id": "f18_breach_flag",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "seen_mara_breach",
          "scope": "player"
        }
      ],
      "once": true
    },
    {
      "id": "mark_lighthouse_mara_f18_visited",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "visited_lighthouse_mara_f18",
          "scope": "player"
        }
      ],
      "once": true
    }
  ]
