  "spawns": [
    { "x": 18, "y": 7, "type": "player_start" },
    { "x": 17, "y": 7, "type": "player_start" },
    { "x": 18, "y": 6, "type": "player_start" },
    { "x": 17, "y": 6, "type": "player_start" }
  ],
  "monsterSpawns": [],
  "npcSpawns": [
    { "type": "archivist_solen", "x": 5, "y": 6 },
    { "type": "records_clerk", "x": 14, "y": 6 },
    { "type": "archives_cat", "x": 17, "y": 11 }
  ],
  "itemSpawns": [],
  "exits": [
    { "x": 18, "y": 7, "leadsTo": "meridian_market", "type": "stairs_down", "spawnX": 1, "spawnY": 16 }
  ],
  "triggers": [
    {
      "id": "enter_archives",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "The Archives. Rows of data terminals and physical records stretch into the distance. The air smells of old paper and ozone.",
          "It's quieter here than the rest of the city. The kind of quiet that comes from people thinking hard."
        ]}
      ],
      "once": true
    },
    {
      "id": "solen_relay_log",
      "event": "npc_interacted",
      "filter": { "npcType": "archivist_solen" },
      "conditions": [
        { "hasItem": "relay_log" },
        { "not": { "hasFlag": "solen_quest_accepted" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "solen_quest_accepted" },
        { "type": "grantXp", "amount": 25 },
        { "type": "showMessage", "lines": [
          "Solen's eyes widen as he reads the relay log. 'Underground movement... thermal signatures not consistent with geological activity...'",
          "'This is extraordinary. The Underlumen — I knew it. Life beneath the surface, using geothermal energy. The planet isn't dead at all.'",
          "'I need more evidence. Survey Marker Delta-7, planted by the original surveyors near the old watchtower. Find it for me, and I'll give you my Resonance Detector prototype.'"
        ]}
      ],
      "once": true
    },
    {
      "id": "set_archives_visited",
      "event": "room_entered",
      "actions": [
        { "type": "setFlag", "flag": "visited_meridian_archives" }
      ],
      "once": true
    },
    {
      "id": "find_cat",
      "event": "npc_interacted",
      "filter": { "npcType": "archives_cat" },
      "conditions": [
        { "hasFlag": "lost_cat_quest_started" },
        { "not": { "hasFlag": "lost_cat_found" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "lost_cat_found" },
        { "type": "grantXp", "amount": 10 },
        { "type": "showMessage", "lines": [
          "The orange tabby purrs and bumps its head against your hand. The collar reads 'EMBER — if found, return to Vell, East Terrace.'",
          "So this is Vell's missing cat. She looks comfortable here — Archivist Solen has clearly been feeding her. You should tell Vell you found her."
        ]}
      ],
      "once": true
    },
    {
      "id": "remove_cat_no_quest",
      "event": "room_entered",
      "conditions": [
        { "not": { "hasFlag": "lost_cat_quest_started" } }
      ],
      "actions": [
        { "type": "removeEntity", "entityType": "npc", "npcType": "archives_cat" }
      ]
    },
    {
      "id": "clerk_courier_quest_start",
      "event": "npc_interacted",
      "filter": { "npcType": "records_clerk" },
      "conditions": [
        { "hasFlag": "visited_meridian_station" },
        { "not": { "hasFlag": "courier_quest_started" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "courier_quest_started" },
        { "type": "grantXp", "amount": 10 },
        { "type": "showMessage", "lines": [
          "The Records Clerk looks up from a stack of transit logs. 'Actually — since you're here. I've been cross-referencing transit logs and something doesn't add up.'",
          "'One of the station couriers, Halden, hasn't filed a cargo manifest in four days. That's not just late — that's unprecedented.'",
          "'Would you ask Station Master Calloway if he's seen Halden? The station is south through the Market Quarter.'"
        ]}
      ],
      "once": true
    },
    {
      "id": "clerk_courier_logbook_return",
      "event": "npc_interacted",
      "filter": { "npcType": "records_clerk" },
      "conditions": [
        { "hasItem": "courier_logbook" },
        { "hasFlag": "courier_quest_started" },
        { "not": { "hasFlag": "courier_quest_complete" } }
      ],
      "actions": [
        { "type": "removeItem", "itemType": "courier_logbook" },
        { "type": "setFlag", "flag": "courier_quest_complete" },
        { "type": "giveItem", "itemType": "shadow_conduit_chip" },
        { "type": "grantXp", "amount": 40 },
        { "type": "showMessage", "lines": [
          "The Records Clerk examines the logbook carefully. 'Torn pages... rerouted shipments... these route codes don't match any authorized transit paths.'",
          "'He was diverting cargo to coordinates outside the city walls. Medical supplies, copper stock, power cells — things the Unbounded traders pay a premium for.'",
          "'I'll file a report with the Civic Center. Here — for your trouble. I found this in the restricted archives last week. It's wasted on a filing clerk.'"
        ]}
      ],
      "once": true
    },
    {
      "id": "solen_marker_delivery",
      "event": "npc_interacted",
      "filter": { "npcType": "archivist_solen" },
      "conditions": [
        { "hasItem": "survey_marker_data" },
        { "hasFlag": "solen_quest_accepted" },
        { "not": { "hasFlag": "solen_quest_complete" } }
      ],
      "actions": [
        { "type": "removeItem", "itemType": "survey_marker_data" },
        { "type": "setFlag", "flag": "solen_quest_complete" },
        { "type": "giveItem", "itemType": "resonance_detector_chip" },
        { "type": "grantXp", "amount": 50 }
      ],
      "once": true
    }
  ]
}
