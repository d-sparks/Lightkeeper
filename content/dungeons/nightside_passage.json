  "triggers": [
    {
      "id": "nightside_passage_enter",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "Unbounded trail markers are scratched into the walls here. Fresh ones. Sable's people have walked this path recently.",
          "The umbracite veins in the walls pulse with a deep, rhythmic light. Like a heartbeat."
        ]}
      ],
      "once": true
    },
    {
      "id": "passage_sable_guide_intro",
      "event": "npc_interacted",
      "filter": { "npcType": "sable_nightside_guide" },
      "conditions": [
        { "hasFlag": "helped_sable" },
        { "not": { "hasFlag": "nightside_expedition_started" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "nightside_expedition_started" },
        { "type": "setFlag", "flag": "sable_guiding" },
        { "type": "incrementFlag", "flag": "sable_trust" },
        { "type": "grantXp", "amount": 40 },
        { "type": "showMessage", "lines": [
          "Sable steps out of the shadows. She's wearing Unbounded deep-travel gear — insulated layers, bioluminescent markers sewn into the seams.",
          "'You came. Good. I've mapped this passage from my grandmother's charts. It leads deeper than any Ring expedition has gone.'",
          "'The Underlumen is strongest below us. The planet's own nervous system. If we can reach it, we can prove to the Array — and to the Council — that biology cannot be synthesized.'",
          "'Stay close. The creatures here are different from the upper caverns. They're older. They've adapted to the deep dark.'"
        ]}
      ],
      "once": true
    },
    {
      "id": "passage_sable_low_trust",
      "event": "npc_interacted",
      "filter": { "npcType": "sable_nightside_guide" },
      "conditions": [
        { "hasFlag": "sable_not_helped" },
        { "not": { "hasFlag": "nightside_expedition_started" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "nightside_expedition_started" },
        { "type": "grantXp", "amount": 20 },
        { "type": "showMessage", "lines": [
          "Sable is here. She doesn't look happy to see you.",
          "'The elders sent me. Not for your sake — for the planet's. The Underlumen doesn't care about grudges.'",
          "'Follow the trail markers. Don't fall behind. I won't come back for you.'"
        ]}
      ],
      "once": true
    },
    {
      "id": "passage_underlumen_pulse",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "nightside_expedition_started" },
        { "not": { "hasFlag": "felt_underlumen_pulse" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "felt_underlumen_pulse" },
        { "type": "showMessage", "lines": [
          "The floor shudders. Not an earthquake — something rhythmic. Purposeful.",
          "The umbracite veins in the walls flare bright for three seconds, then dim. Flare again. Dim.",
          "It's breathing. The planet is breathing."
        ]}
      ],
      "once": true
    },
    {
      "id": "passage_symbiotic_sample",
      "event": "door_interacted",
      "filter": { "tileX": 23, "tileY": 16 },
      "conditions": [
        { "hasFlag": "nightside_expedition_started" },
        { "not": { "hasFlag": "collected_symbiotic_sample" } }
      ],
      "actions": [
        { "type": "spawnItem", "itemType": "symbiotic_compound", "x": 23, "y": 15 },
        { "type": "setFlag", "flag": "collected_symbiotic_sample" },
        { "type": "grantXp", "amount": 30 },
        { "type": "showMessage", "lines": [
          "The sealed formation cracks open. Inside, a mass of crystalline-organic matter glows with inner warmth.",
          "This isn't mineral and it isn't biological — it's both. A living compound that requires symbiosis to exist.",
          "This is what Asha needs. Proof that the Array can never replicate true biological communion."
        ]}
      ],
      "once": true
    },
    {
      "id": "passage_deep_marker",
      "event": "item_picked_up",
      "filter": { "itemType": "refined_umbrasite" },
      "conditions": [
        { "hasFlag": "nightside_expedition_started" }
      ],
      "actions": [
        { "type": "showMessage", "text": "The refined umbracite pulses in sync with the walls. This deep, the crystals are nearly alive — resonating with the Underlumen far below." }
      ],
      "once": true
    },
    {
      "id": "passage_exit_warning",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "nightside_expedition_started" },
        { "not": { "hasFlag": "passage_exit_warned" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "passage_exit_warned" },
        { "type": "showMessage", "lines": [
          "The passage opens into a vast natural cavern. Far below, through gaps in the stone, you see light — not sunlight, not Sol light.",
          "A deep, warm bioluminescence radiates from somewhere beneath the planet's crust. The Underlumen.",
          "The stairs at the far end descend toward it. There will be no turning back easily from what lies below."
        ]}
      ],
      "once": true
    },
    {
      "id": "chest_loot_nightside_passage",
      "event": "door_interacted",
      "filter": { "tileName": "chest_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "frost_biome_rare" }
      ]
    }
  ]
}
