  "triggers": [
    {
      "id": "f19_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "The deepest chamber. The walls here aren't stone or metal — they're something else. Smooth, dark, covered in geometric patterns that glow faintly when your sol unit passes near.",
            "This is Underlumen architecture. Not ancient ruins — active structure. The patterns pulse with the same 4.7-second rhythm the survey equipment detected. Whatever broke through the lighthouse foundation lives here.",
            "Something is waiting in the chamber ahead. You can feel it — a presence, vast and patient, vibrating through the floor beneath your feet."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f19_boss_killed",
      "event": "monster_killed",
      "filter": {
        "monsterType": "underlumen_emergence"
      },
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "The Emergence collapses, its geometric form fracturing into cold light that dissipates into the walls. The 4.7-second pulse stutters — then resumes, weaker.",
            "It wasn't the source. It was a symptom. Whatever is generating that pulse is deeper still — far below, in the planetary substrate the surveys couldn't reach.",
            "But the path to the lighthouse core is clear now. If you can restore power, Mara lives again. The questions about what's underneath can wait. The cold cannot."
          ]
        },
        {
          "type": "setFlag",
          "flag": "underlumen_emergence_defeated",
          "scope": "player"
        },
        {
          "type": "spawnItem",
          "itemType": "void_resonator_chip",
          "x": 10,
          "y": 11
        }
      ],
      "once": true
    },
    {
      "id": "f19_chest",
      "event": "door_interacted",
      "filter": {
        "tileName": "chest_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "frost_biome_rare"
        }
      ]
    },
    {
      "id": "mark_lighthouse_mara_f19_visited",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "visited_lighthouse_mara_f19",
          "scope": "player"
        }
      ],
      "once": true
    }
  ],
  "sim_passthrough": true
