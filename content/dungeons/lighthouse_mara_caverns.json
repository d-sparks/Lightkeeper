  "triggers": [
    {
      "id": "cavern_enter",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "Frost-covered stairs give way to a natural cavern system beneath the relay station. The cold is immediate and biting.",
          "The walls are cracked — not from weathering, but from pressure below. Deep grooves run through the ice in unnervingly regular patterns."
        ]}
      ],
      "once": true
    },
    {
      "id": "keepers_journal_pickup",
      "event": "item_picked_up",
      "filter": { "itemType": "keepers_journal" },
      "actions": [
        { "type": "showMessage", "lines": [
          "The journal is half-frozen, but legible. The keeper's handwriting grows more erratic toward the end:",
          "\"Day 1,204. Micro-fractures in the foundation again. Engineering says it's thermal stress. I don't think so.\"",
          "\"Day 1,206. The cracks are geometric. Perfect angles. Frost doesn't make perfect angles.\"",
          "\"Day 1,207. The ground shook at 0300. Not an earthquake — it came from directly below the core. The instruments are showing readings at a depth that shouldn't have anything in it.\"",
          "\"Day 1,208. Going dark. Whatever is down there just broke through the sub-basement.\""
        ]}
      ],
      "once": true
    },
    {
      "id": "power_cell_pickup",
      "event": "item_picked_up",
      "filter": { "itemType": "mara_power_cell" },
      "actions": [
        { "type": "showMessage", "text": "The backup power cell still holds a charge. Keeper Renn said this could restart the lighthouse core — if you can reach it." },
        { "type": "setFlag", "flag": "has_mara_power_cell", "scope": "player" }
      ],
      "once": true
    },
    {
      "id": "structural_damage_clue",
      "event": "room_entered",
      "conditions": [
        { "not": { "hasFlag": "noticed_structural_damage" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "noticed_structural_damage", "scope": "player" },
        { "type": "showMessage", "text": "The cracked ice walls here show a distinct pattern — the fractures radiate outward from deep below, as if something pushed up through the bedrock. This damage isn't surface erosion. It's structural. From underneath." }
      ],
      "once": true
    },
    {
      "id": "frozen_door_hint",
      "event": "door_interacted",
      "filter": { "tileX": 3, "tileY": 4 },
      "actions": [
        { "type": "showMessage", "text": "The frozen door groans open, revealing a small alcove. Someone sheltered here recently — the keeper, perhaps." }
      ],
      "once": true
    },
    {
      "id": "chest_loot_caverns",
      "event": "door_interacted",
      "filter": { "tileName": "chest_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "frost_biome_uncommon" }
      ]
    },
    {
      "id": "mark_caverns_visited",
      "event": "room_entered",
      "actions": [
        { "type": "setFlag", "flag": "visited_mara_caverns", "scope": "player" }
      ],
      "once": true
    }
  ]
