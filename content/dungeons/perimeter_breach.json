  "triggers": [
    {
      "id": "breach_enter",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "lines": [
          "The old perimeter wall is torn apart here. Massive claw marks score the concrete. Emergency lights flicker erratically.",
          "This is where the Nightside creatures have been getting through. This is where Tannis was attacked."
        ]}
      ],
      "once": true
    },
    {
      "id": "lore_raider_confession_pickup",
      "event": "item_picked_up",
      "filter": { "itemType": "lore_raider_confession" },
      "actions": [
        { "type": "showMessage", "lines": [
          "A bloodstained letter clutched in a skeletal hand, half-buried in rubble:",
          "'To whoever finds this — we are not what they say. We left the Ring because we saw what the Array is building. Not solar panels. Not harvesters. Something underneath, something vast.'",
          "'The Lighthouses keep more than the dark out. They keep something IN. We tried to warn them. They called us savages. — Kael, of the Unbounded'",
          "The Unbounded have a presence near Meridian. Someone there might know more about Kael's claims."
        ]}
      ],
      "once": true
    },
    {
      "id": "dog_tags_pickup",
      "event": "item_picked_up",
      "filter": { "itemType": "tannis_dog_tags" },
      "actions": [
        { "type": "showMessage", "lines": [
          "Standard-issue identification tags, half-buried in rubble. The chain is snapped — torn off by force.",
          "\"PVT. TANNIS, R.\" — Tannis from the infirmary. He'd probably want these back."
        ]},
        { "type": "setFlag", "flag": "found_tannis_tags" }
      ],
      "once": true
    },
    {
      "id": "breach_wraith_killed",
      "event": "monster_killed",
      "filter": { "monsterType": "gloom_wraith" },
      "actions": [
        { "type": "showMessage", "lines": [
          "The Gloom Wraith collapses. Without its coordination, the remaining creatures scatter back into the dark.",
          "The breach is clear — for now. Report back to Warden Holt."
        ]},
        { "type": "setFlag", "flag": "perimeter_breach_cleared" }
      ],
      "once": true
    }
  ]
