  "triggers": [
    {
      "id": "f14_enter",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "Metal panels appear beneath the ice. You've reached the lighthouse sub-basement — engineering infrastructure buried far deeper than the surface structure suggests.",
            "The panels are buckled upward, bent by force from below. Conduit bundles hang from the ceiling like frozen intestines, sheared clean through."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "f14_chest",
      "event": "door_interacted",
      "filter": {
        "tileName": "chest_closed"
      },
      "actions": [
        {
          "type": "rollLootTable",
          "lootTable": "frost_biome_rare"
        }
      ]
    },
    {
      "id": "f14_machinery_1",
      "event": "door_interacted",
      "filter": {
        "tileX": 20,
        "tileY": 2
      },
      "actions": [
        {
          "type": "showMessage",
          "text": "A buckled control panel. The readout is frozen mid-display: \"SUB-BASEMENT BREACH DETECTED — LEVEL 4 — EVACUATE.\" The timestamp is three days before Lighthouse Mara went dark."
        }
      ],
      "once": true
    },
    {
      "id": "f14_machinery_2",
      "event": "door_interacted",
      "filter": {
        "tileX": 3,
        "tileY": 9
      },
      "actions": [
        {
          "type": "showMessage",
          "text": "An emergency terminal, still drawing from backup power. Status: all sub-basement levels below this one are offline. Structural integrity readings show progressive failure from the deepest levels upward."
        }
      ],
      "once": true
    },
    {
      "id": "mark_lighthouse_mara_f14_visited",
      "event": "room_entered",
      "actions": [
        {
          "type": "setFlag",
          "flag": "visited_lighthouse_mara_f14",
          "scope": "player"
        }
      ],
      "once": true
    }
