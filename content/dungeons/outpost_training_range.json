  "triggers": [
    {
      "id": "enter_training_range",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "The training range. Reinforced walls and scoring panels line the far end.",
            "Three training targets are set up across the room. Use your Sol Beam [key 1] to take them out."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "training_first_kill",
      "event": "monster_killed",
      "filter": {
        "monsterType": "training_target"
      },
      "conditions": [
        {
          "not": {
            "hasFlag": "training_targets_killed"
          }
        }
      ],
      "actions": [
        {
          "type": "incrementFlag",
          "flag": "training_targets_killed"
        },
        {
          "type": "showMessage",
          "text": "Direct hit. The Sol Beam channels concentrated solar energy — nothing on this rock can take many of those."
        }
      ],
      "once": true
    },
    {
      "id": "training_kill_counter",
      "event": "monster_killed",
      "filter": {
        "monsterType": "training_target"
      },
      "conditions": [
        {
          "hasFlag": "training_targets_killed"
        }
      ],
      "actions": [
        {
          "type": "incrementFlag",
          "flag": "training_targets_killed"
        }
      ]
    },
    {
      "id": "training_second_kill",
      "event": "flag_changed",
      "filter": {
        "flag": "training_targets_killed"
      },
      "conditions": [
        {
          "hasFlag": "training_targets_killed",
          "value": 2
        }
      ],
      "actions": [
        {
          "type": "showMessage",
          "text": "Good shot. One more target. Watch your energy — the Sol Beam draws from your unit's reserves."
        }
      ],
      "once": true
    },
    {
      "id": "training_complete",
      "event": "flag_changed",
      "filter": {
        "flag": "training_targets_killed"
      },
      "conditions": [
        {
          "flagGreaterThan": {
            "flag": "training_targets_killed",
            "value": 2
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "sol_training_complete"
        },
        {
          "type": "showMessage",
          "lines": [
            "All targets down. But your Sol Unit's energy is critically low.",
            "That unit was running on fumes when you got it. You need a proper charge before heading into the field.",
            "Head to the Power Station — back through the workshop, then south through the main hall. Tech Maren runs the charging terminals."
          ]
        }
      ],
      "once": true
    }
  ]
}
