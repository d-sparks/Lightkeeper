  "triggers": [
    {
      "id": "enter_training_range",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "lines": [
            "The training range. Reinforced walls and scoring panels line the far end.",
            "Training targets are set up across the room. Fire your Sol Cone [key 2] at them — then finish off any survivors with your blaster."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "training_cone_used",
      "event": "ability_used",
      "filter": {
        "abilityId": "sol_cone"
      },
      "actions": [
        {
          "type": "incrementFlag",
          "flag": "training_cone_uses"
        }
      ]
    },
    {
      "id": "training_first_cone",
      "event": "flag_changed",
      "filter": {
        "flag": "training_cone_uses"
      },
      "conditions": [
        {
          "hasFlag": "training_cone_uses",
          "value": 1
        }
      ],
      "actions": [
        {
          "type": "showMessage",
          "text": "Direct hit. The Sol Cone channels concentrated solar energy in a wide blast — but it drains your battery fast. Fire it once more."
        }
      ],
      "once": true
    },
    {
      "id": "training_second_cone",
      "event": "flag_changed",
      "filter": {
        "flag": "training_cone_uses"
      },
      "conditions": [
        {
          "hasFlag": "training_cone_uses",
          "value": 2
        }
      ],
      "actions": [
        {
          "type": "showMessage",
          "text": "Your battery is empty. Sol abilities need energy — and you just burned through yours. Use your blaster to finish off the remaining targets."
        }
      ],
      "once": true
    },
    {
      "id": "training_kill_counter",
      "event": "monster_killed",
      "filter": {
        "monsterType": "training_target"
      },
      "actions": [
        {
          "type": "incrementFlag",
          "flag": "training_targets_killed"
        }
      ]
    },
    {
      "id": "training_complete",
      "event": "flag_changed",
      "filter": {
        "flag": "training_targets_killed"
      },
      "conditions": [
        {
          "flagGreaterThan": {
            "flag": "training_targets_killed",
            "value": 1
          }
        },
        {
          "flagGreaterThan": {
            "flag": "training_cone_uses",
            "value": 1
          }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "sol_training_complete"
        },
        {
          "type": "showMessage",
          "lines": [
            "Training complete. You felt the difference — the Sol Cone hits hard but empties your reserves.",
            "Out in the field, energy management is life and death. Your blaster costs nothing, but your sol abilities need power.",
            "Head to the Power Station — Tech Maren can set you up with a field battery. Back through the workshop, then south."
          ]
        }
      ],
      "once": true
    },
    {
      "id": "training_complete_from_cone",
      "event": "flag_changed",
      "filter": {
        "flag": "training_cone_uses"
      },
      "conditions": [
        {
          "flagGreaterThan": {
            "flag": "training_targets_killed",
            "value": 1
          }
        },
        {
          "flagGreaterThan": {
            "flag": "training_cone_uses",
            "value": 1
          }
        },
        {
          "not": { "hasFlag": "sol_training_complete" }
        }
      ],
      "actions": [
        {
          "type": "setFlag",
          "flag": "sol_training_complete"
        },
        {
          "type": "showMessage",
          "lines": [
            "Training complete. You felt the difference — the Sol Cone hits hard but empties your reserves.",
            "Out in the field, energy management is life and death. Your blaster costs nothing, but your sol abilities need power.",
            "Head to the Power Station — Tech Maren can set you up with a field battery. Back through the workshop, then south."
          ]
        }
      ],
      "once": true
    }
  ]
}
