    { "type": "training_target", "x": 5, "y": 6, "patrol": "stationary" },
    { "type": "training_target", "x": 14, "y": 6, "patrol": "stationary" },
    { "type": "training_target", "x": 9, "y": 11, "patrol": "stationary" }
