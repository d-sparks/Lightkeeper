  "triggers": [
    {
      "id": "enter_power_station",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "text": "The hum of the solar capacitor banks fills the room. Indicator lights pulse along the charging terminals."
        }
      ],
      "once": true
    },
    {
      "id": "give_generator_chip",
      "event": "npc_interacted",
      "filter": {
        "npcType": "charging_tech_maren"
      },
      "conditions": [
        { "hasFlag": "received_first_battery" },
        { "not": { "hasFlag": "received_generator_chip" } }
      ],
      "actions": [
        {
          "type": "giveItem",
          "itemType": "basic_generator_chip"
        },
        {
          "type": "setFlag",
          "flag": "received_generator_chip"
        },
        {
          "type": "showMessage",
          "text": "Open your inventory [I] and place the generator chip on your Sol Grid — it works best adjacent to your battery chip."
        }
      ],
      "once": true
    },
    {
      "id": "give_battery_chip",
      "event": "npc_interacted",
      "filter": {
        "npcType": "charging_tech_maren"
      },
      "conditions": [
        {
          "hasFlag": "sol_training_complete"
        },
        {
          "or": [
            { "not": { "hasItem": "single_use_battery_chip" } },
            { "singleUseEnergyBelow": 15 }
          ]
        }
      ],
      "actions": [
        {
          "type": "giveItem",
          "itemType": "single_use_battery_chip"
        },
        {
          "type": "setFlag",
          "flag": "received_first_battery"
        },
        {
          "type": "showMessage",
          "text": "Open your inventory [I] to place the battery chip on your Sol Grid next to your Sol Cone."
        }
      ]
    },
    {
      "id": "enter_power_station_needs_battery",
      "event": "room_entered",
      "conditions": [
        {
          "hasFlag": "sol_training_complete"
        },
        {
          "or": [
            { "not": { "hasItem": "single_use_battery_chip" } },
            { "singleUseEnergyBelow": 15 }
          ]
        }
      ],
      "actions": [
        {
          "type": "showMessage",
          "text": "Your Sol Unit's energy reserve is drained. Talk to Tech Maren — she keeps field cells for deployment."
        }
      ]
    }
