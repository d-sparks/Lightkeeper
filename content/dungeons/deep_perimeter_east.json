    {
      "id": "deep_perimeter_enter",
      "event": "room_entered",
      "actions": [
        { "type": "showMessage", "text": "Old perimeter markers jut from the ground at intervals, their territorial carvings eroded almost to nothing. Unbounded symbols — Sable's people were here, once." }
      ],
      "once": true
    },
    {
      "id": "umbracite_deposit_1",
      "event": "item_picked_up",
      "filter": { "itemType": "umbracite" },
      "conditions": [
        { "not": { "hasFlag": "found_deep_umbracite" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "found_deep_umbracite" },
        { "type": "showMessage", "lines": [
          "Umbracite deposits — clusters of dark crystal embedded in the rock, larger and more pure than anything near the outpost.",
          "This is the primary source. The Array wants this material desperately. You're starting to understand why."
        ]}
      ],
      "once": true
    },
    {
      "id": "umbral_seed_deep_reaction",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "umbral_seed_planted" },
        { "not": { "hasFlag": "umbral_seed_dark_exposed" } }
      ],
      "actions": [
        { "type": "setFlag", "flag": "umbral_seed_dark_exposed" },
        { "type": "showMessage", "lines": [
          "Something stirs in your pack. The Umbral Seed — you brought it from the homestead pot for dark exposure.",
          "Out here, in the true Nightside, the seed is responding. Its bioluminescent pulse quickens, matching a rhythm you can't hear but can feel in your bones.",
          "The seed is drinking in the darkness. Changing."
        ]}
      ],
      "once": true
    },
    {
      "id": "fen_cache_hint",
      "event": "room_entered",
      "conditions": [
        { "hasFlag": "fen_letter_accepted" },
        { "not": { "hasFlag": "found_fen_cache" } }
      ],
      "actions": [
        { "type": "showMessage", "text": "According to Fen's description, the squad's supply cache should be through a collapsed passage to the northeast." }
      ],
      "once": true
    }
  ]
