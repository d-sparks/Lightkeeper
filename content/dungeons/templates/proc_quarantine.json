{
  "id": "proc_quarantine",
  "type": "procedural",
  "namePattern": "Quarantine Wing - Level {depth}",
  "tileset": "crypt",
  "tileSize": 32,
  "depth": { "min": 1, "max": 3 },

  "grid": {
    "width": 50,
    "height": 35,
    "wallTile": 3,
    "floorTile": 1,
    "altFloorTile": 2,
    "altFloorChance": 0.05
  },

  "rooms": {
    "count": { "min": 5, "max": 8 },
    "width": { "min": 5, "max": 10 },
    "height": { "min": 5, "max": 8 },
    "padding": 2,
    "maxPlacementAttempts": 200
  },

  "corridors": {
    "width": { "min": 2, "max": 3 },
    "doorChance": 0.3,
    "doorTile": 4,
    "extraConnectionChance": 0.2
  },

  "requiredRooms": [
    {
      "tag": "entrance",
      "isEntrance": true,
      "width": { "min": 5, "max": 7 },
      "height": { "min": 5, "max": 7 }
    },
    {
      "tag": "exit_room",
      "isExit": true,
      "maxDepth": 2,
      "width": { "min": 4, "max": 6 },
      "height": { "min": 4, "max": 6 }
    },
    {
      "tag": "supply_alcove",
      "depth": 1,
      "width": { "min": 4, "max": 5 },
      "height": { "min": 4, "max": 5 },
      "itemSpawns": [
        { "type": "supply_manifest", "position": "center" }
      ]
    },
    {
      "tag": "treasure",
      "depth": 2,
      "placeNear": "entrance",
      "width": { "min": 5, "max": 6 },
      "height": { "min": 5, "max": 6 },
      "centerTile": 10
    },
    {
      "tag": "boss",
      "depth": 3,
      "width": { "min": 7, "max": 10 },
      "height": { "min": 7, "max": 9 },
      "monsterSpawns": [
        { "type": "luddite_warlord", "position": "center" }
      ]
    }
  ],

  "exits": {
    "entrance": { "tile": 8, "position": "entrance_room", "leadsTo": "$source" },
    "descent": { "tile": 6, "position": "exit_room", "leadsTo": "$next", "hideDescentOnLast": true }
  },

  "monsters": {
    "budget": { "base": 4, "perDepth": 2 },
    "pool": [
      { "type": "luddite_brawler", "weight": 3, "cost": 1, "minDepth": 0 },
      { "type": "luddite_scrapper", "weight": 2, "cost": 2, "minDepth": 2 }
    ],
    "maxPerRoom": 3,
    "avoidEntranceRoom": true
  },

  "items": {
    "pool": [
      { "type": "medical_supplies", "weight": 5, "max": 3 }
    ],
    "countRange": { "min": 1, "max": 3 }
  },

  "triggers": [
    {
      "id": "enter_{instanceId}",
      "event": "room_entered",
      "depth": 1,
      "actions": [
        { "type": "showMessage", "text": "You enter the quarantine wing. The air is stale and the lights flicker." }
      ],
      "once": true
    },
    {
      "id": "enter_{instanceId}",
      "event": "room_entered",
      "depth": 2,
      "actions": [
        { "type": "showMessage", "lines": [
          "Deeper into luddite territory. A locked supply crate should be somewhere on this level.",
          "You'll need a key to open it."
        ]}
      ],
      "once": true
    },
    {
      "id": "enter_{instanceId}",
      "event": "room_entered",
      "depth": 3,
      "actions": [
        { "type": "showMessage", "text": "The luddite warlord's stronghold. The air hums with tension." }
      ],
      "once": true
    },
    {
      "id": "warlord_killed_{instanceId}",
      "event": "monster_killed",
      "depth": 3,
      "filter": { "monsterType": "luddite_warlord" },
      "actions": [
        { "type": "setFlag", "flag": "warlord_defeated" },
        { "type": "spawnItem", "itemType": "supply_crate_key" },
        { "type": "showMessage", "text": "The warlord falls. A key clatters to the ground." }
      ],
      "once": true
    },
    {
      "id": "key_pickup_{instanceId}",
      "event": "item_picked_up",
      "depth": 3,
      "filter": { "itemType": "supply_crate_key" },
      "actions": [
        { "type": "showMessage", "text": "Supply Crate Key obtained. There was a locked crate on the level above." }
      ],
      "once": true
    },
    {
      "id": "cylinder_pickup_{instanceId}",
      "event": "item_picked_up",
      "depth": 2,
      "requiresRoom": "treasure",
      "filter": { "itemType": "titanium_cylinders" },
      "actions": [
        { "type": "showMessage", "text": "Titanium Power Cylinders recovered! Return to the engineer in the workshop." }
      ],
      "once": true
    },
    {
      "id": "chest_opened_{instanceId}",
      "event": "door_interacted",
      "depth": 2,
      "requiresRoom": "treasure",
      "filter": { "tileX": "{treasure.cx}", "tileY": "{treasure.cy}" },
      "actions": [
        { "type": "spawnItem", "itemType": "titanium_cylinders", "x": "{treasure.cx}", "y": "{treasure.cy}" }
      ],
      "once": true
    }
  ],

  "spawns": {
    "count": 4,
    "position": "entrance_room"
  }
}
