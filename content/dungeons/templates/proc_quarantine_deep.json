{
  "id": "proc_quarantine_deep",
  "type": "procedural",
  "namePattern": "Quarantine Depth {depth}",
  "tileset": "crypt",
  "theme": "quarantine_zone",
  "tileSize": 32,
  "depth": { "min": 4, "max": 10 },

  "grid": {
    "width": 60,
    "height": 40,
    "wallTile": 3,
    "floorTile": 1,
    "altFloorTile": 2,
    "altFloorChance": 0.05
  },

  "rooms": {
    "count": { "min": 6, "max": 10 },
    "width": { "min": 5, "max": 12 },
    "height": { "min": 5, "max": 10 },
    "padding": 2,
    "maxPlacementAttempts": 200
  },

  "corridors": {
    "width": { "min": 2, "max": 3 },
    "doorChance": 0.4,
    "doorTile": 4,
    "extraConnectionChance": 0.25
  },

  "requiredRooms": [
    {
      "tag": "entrance",
      "isEntrance": true,
      "width": { "min": 5, "max": 7 },
      "height": { "min": 5, "max": 7 }
    },
    {
      "tag": "exit_room",
      "isExit": true,
      "width": { "min": 4, "max": 6 },
      "height": { "min": 4, "max": 6 }
    },
    {
      "tag": "treasure",
      "width": { "min": 4, "max": 5 },
      "height": { "min": 4, "max": 5 },
      "centerTile": 30
    }
  ],

  "exits": {
    "entrance": { "tile": 8, "position": "entrance_room", "leadsTo": "$source" },
    "descent":  { "tile": 6, "position": "exit_room", "leadsTo": "$next" }
  },

  "monsters": {
    "budget": { "base": 5, "perDepth": 2 },
    "pool": [
      { "type": "skeleton", "weight": 3, "cost": 1, "minDepth": 0 },
      { "type": "luddite_brawler", "weight": 2, "cost": 1, "minDepth": 0 },
      { "type": "luddite_scrapper", "weight": 1, "cost": 2, "minDepth": 2 },
      { "type": "tunnel_creeper", "weight": 2, "cost": 1, "minDepth": 0 },
      { "type": "feral_hound", "weight": 2, "cost": 1, "minDepth": 1 }
    ],
    "maxPerRoom": 4,
    "avoidEntranceRoom": true
  },

  "items": {
    "pool": [
      { "type": "medical_supplies", "weight": 5, "max": 2 }
    ],
    "countRange": { "min": 0, "max": 2 }
  },

  "triggers": [
    {
      "id": "enter_{instanceId}",
      "event": "room_entered",
      "actions": [
        {
          "type": "showMessage",
          "text": "The tunnels stretch deeper. The air grows thick."
        }
      ],
      "once": true
    },
    {
      "id": "chest_loot_{instanceId}",
      "event": "door_interacted",
      "maxDepth": 6,
      "requiresRoom": "treasure",
      "filter": { "tileName": "crate_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "outpost_biome_common", "x": "{treasure.cx}", "y": "{treasure.cy}" },
        { "type": "showMessage", "text": "Old supplies, still usable." }
      ],
      "once": true
    },
    {
      "id": "chest_loot_{instanceId}",
      "event": "door_interacted",
      "minDepth": 7,
      "requiresRoom": "treasure",
      "filter": { "tileName": "crate_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "outpost_biome_rare", "x": "{treasure.cx}", "y": "{treasure.cy}" },
        { "type": "showMessage", "text": "A well-preserved cache from before the quarantine." }
      ],
      "once": true
    }
  ],

  "spawns": {
    "count": 4,
    "position": "entrance_room"
  }
}
