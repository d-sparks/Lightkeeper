{
  "id": "proc_geothermal",
  "type": "procedural",
  "namePattern": "Geothermal Vents - Level {depth}",
  "tileset": "dayside",
  "theme": "geothermal",
  "tileSize": 32,
  "environmentalHazard": { "type": "heat", "damage": 3, "interval": 4.0 },
  "depth": { "min": 1, "max": 4 },

  "grid": {
    "width": 50,
    "height": 38,
    "wallTile": 3,
    "floorTile": 1,
    "altFloorTile": 2,
    "altFloorChance": 0.22
  },

  "rooms": {
    "count": { "min": 5, "max": 9 },
    "width": { "min": 5, "max": 11 },
    "height": { "min": 5, "max": 9 },
    "padding": 2,
    "maxPlacementAttempts": 200
  },

  "corridors": {
    "width": { "min": 2, "max": 3 },
    "doorChance": 0.15,
    "doorTile": 4,
    "extraConnectionChance": 0.25
  },

  "requiredRooms": [
    {
      "tag": "entrance",
      "isEntrance": true,
      "width": { "min": 5, "max": 7 },
      "height": { "min": 5, "max": 7 }
    },
    {
      "tag": "exit_room",
      "isExit": true,
      "maxDepth": 3,
      "width": { "min": 4, "max": 6 },
      "height": { "min": 4, "max": 6 }
    },
    {
      "tag": "treasure",
      "width": { "min": 4, "max": 5 },
      "height": { "min": 4, "max": 5 },
      "centerTile": 10
    },
    {
      "tag": "vent_chamber",
      "depth": 2,
      "width": { "min": 6, "max": 8 },
      "height": { "min": 5, "max": 7 },
      "centerTile": 7
    },
    {
      "tag": "magma_core",
      "depth": 4,
      "width": { "min": 9, "max": 12 },
      "height": { "min": 8, "max": 10 },
      "monsterSpawns": [
        { "type": "magma_brute", "position": "center" },
        { "type": "vent_spewer", "position": "random" },
        { "type": "vent_spewer", "position": "random" }
      ]
    }
  ],

  "exits": {
    "entrance": { "tile": 8, "position": "entrance_room", "leadsTo": "$source" },
    "descent": { "tile": 6, "position": "exit_room", "leadsTo": "$next", "hideDescentOnLast": true }
  },

  "monsters": {
    "budget": { "base": 3, "perDepth": 3 },
    "pool": [
      { "type": "vent_spewer", "weight": 3, "cost": 1, "minDepth": 0 },
      { "type": "magma_brute", "weight": 1, "cost": 3, "minDepth": 2 }
    ],
    "maxPerRoom": 3,
    "avoidEntranceRoom": true
  },

  "items": {
    "pool": [
      { "type": "silicon", "weight": 4, "max": 3 },
      { "type": "flare", "weight": 3, "max": 2 },
      { "type": "health_potion", "weight": 2, "max": 2 }
    ],
    "countRange": { "min": 1, "max": 3 }
  },

  "triggers": [
    {
      "id": "enter_{instanceId}",
      "event": "room_entered",
      "depth": 1,
      "actions": [
        { "type": "showMessage", "text": "Waves of heat shimmer above cracked stone. Steam hisses from fissures in the ground." }
      ],
      "once": true
    },
    {
      "id": "enter_{instanceId}",
      "event": "room_entered",
      "depth": 2,
      "actions": [
        { "type": "showMessage", "text": "The vents grow larger here. Geysers of superheated vapor erupt without warning." }
      ],
      "once": true
    },
    {
      "id": "enter_{instanceId}",
      "event": "room_entered",
      "depth": 3,
      "actions": [
        { "type": "showMessage", "text": "Molten rock glows faintly beneath thin stone crusts. The air burns with every breath." }
      ],
      "once": true
    },
    {
      "id": "enter_{instanceId}",
      "event": "room_entered",
      "depth": 4,
      "actions": [
        { "type": "showMessage", "text": "The magma core. A massive brute guards the heart of the geothermal field." }
      ],
      "once": true
    },
    {
      "id": "chest_loot_{instanceId}",
      "event": "door_interacted",
      "maxDepth": 2,
      "requiresRoom": "treasure",
      "filter": { "tileName": "chest_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "geothermal_biome_common", "x": "{treasure.cx}", "y": "{treasure.cy}" },
        { "type": "showMessage", "text": "The heat-warped crate yields some salvage." }
      ],
      "once": true
    },
    {
      "id": "chest_loot_{instanceId}",
      "event": "door_interacted",
      "depth": 3,
      "requiresRoom": "treasure",
      "filter": { "tileName": "chest_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "geothermal_biome_uncommon", "x": "{treasure.cx}", "y": "{treasure.cy}" },
        { "type": "showMessage", "text": "Scorch marks cover the crate, but the contents are intact." }
      ],
      "once": true
    },
    {
      "id": "chest_loot_{instanceId}",
      "event": "door_interacted",
      "depth": 4,
      "requiresRoom": "treasure",
      "filter": { "tileName": "chest_closed" },
      "actions": [
        { "type": "rollLootTable", "lootTable": "geothermal_biome_rare", "x": "{treasure.cx}", "y": "{treasure.cy}" },
        { "type": "showMessage", "text": "A heat-shielded container. Rare components inside, still functional." }
      ],
      "once": true
    },
    {
      "id": "magma_brute_killed_{instanceId}",
      "event": "monster_killed",
      "depth": 4,
      "requiresRoom": "magma_core",
      "filter": { "monsterType": "magma_brute" },
      "actions": [
        { "type": "setFlag", "flag": "magma_core_cleared" },
        { "type": "spawnItem", "itemType": "silicon" },
        { "type": "showMessage", "text": "The Magma Brute crumbles. The chamber cools as the vent pressure drops. Crystallized silicon remains." }
      ],
      "once": true
    }
  ],

  "spawns": {
    "count": 4,
    "position": "entrance_room"
  }
}
